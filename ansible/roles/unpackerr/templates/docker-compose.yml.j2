# docker-compose.yml for Unpackerr ({{ instance }})
# Managed by homelab-infra. The Arr API keys come from Vaultwarden through the media registry; do not copy this file or its environment values elsewhere.
services:
  {{ instance }}:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}"
    restart: unless-stopped
    user: "{{ app_config.app.puid | default(1313) }}:{{ app_config.app.pgid | default(1313) }}"
    labels:
      - "com.centurylinklabs.watchtower.enable=true"
    environment:
      - TZ={{ homelabinfra_config.timezone | default('UTC') }}
      - UN_PARALLEL={{ app_config.app.parallel | default(1) }}
{% for arr in _unpackerr_arrs %}
{% set arr_index = _unpackerr_arrs[:loop.index0] | selectattr('value.app', 'equalto', arr.value.app) | list | length %}
      - UN_{{ arr.value.app | upper }}_{{ arr_index }}_URL={{ arr.value.host }}
      - UN_{{ arr.value.app | upper }}_{{ arr_index }}_API_KEY={{ arr.value.api_key }}
      - UN_{{ arr.value.app | upper }}_{{ arr_index }}_PATHS_0={{ app_config.app.download_path }}
      - UN_{{ arr.value.app | upper }}_{{ arr_index }}_PROTOCOLS={{ app_config.app.protocols }}
{% endfor %}
    volumes:
{% for mount in _unpackerr_mounts %}
      - "{{ mount.path }}:{{ mount.path }}"
{% endfor %}
