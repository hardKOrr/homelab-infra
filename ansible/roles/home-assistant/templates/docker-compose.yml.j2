{{ ansible_managed | comment }}
services:
  homeassistant:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}-home-assistant"
    restart: unless-stopped
    ports:
      - "{{ app_config.app.port }}:8123"
    volumes:
      - "{{ app_config.app.config_path }}:/config"
      - /etc/localtime:/etc/localtime:ro
    devices:
      # Only the exact serial node for the mapped coordinator enters the container.
      # The Proxmox mapping is the physical-device identity; this is its guest path.
      - "{{ app_config.app.usb_device_path }}:{{ app_config.app.usb_device_path }}"
    healthcheck:
      test: ["CMD-SHELL", "wget --spider --quiet http://127.0.0.1:8123/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 60s
