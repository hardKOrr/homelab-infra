{{ ansible_managed | comment }}
{% set q = '"' if app_config.hosting.method == 'native' else '' %}
APP_URL={{ q }}https://{{ bookstack_fqdn }}{{ q }}
APP_KEY={{ q }}{{ _bookstack_app_key }}{{ q }}
APP_ENV={{ q }}production{{ q }}
APP_DEBUG={{ q }}false{{ q }}
{% if app_config.hosting.method == 'docker' %}
PUID={{ app_config.app.puid }}
PGID={{ app_config.app.pgid }}
TZ={{ homelabinfra_config.timezone | default('UTC') }}
{% endif %}
DB_CONNECTION={{ q }}mysql{{ q }}
DB_HOST={{ q }}{{ app_config.app.database_host }}{{ q }}
DB_PORT={{ q }}{{ app_config.app.database_port }}{{ q }}
DB_DATABASE={{ q }}{{ app_config.app.database.name }}{{ q }}
DB_USERNAME={{ q }}{{ app_config.app.database_user }}{{ q }}
DB_PASSWORD={{ q }}{{ app_config.app.database_password }}{{ q }}
MAIL_DRIVER={{ q }}{{ 'smtp' if wiring_mail.enabled else 'log' }}{{ q }}
MAIL_FROM={{ q }}{{ wiring_mail.from_address | default('bookstack@example.invalid', true) }}{{ q }}
MAIL_FROM_NAME={{ q }}{{ wiring_mail.from_name | default('BookStack', true) }}{{ q }}
MAIL_HOST={{ q }}{{ wiring_mail.host | default('localhost', true) }}{{ q }}
MAIL_PORT={{ q }}{{ wiring_mail.port | default(25, true) }}{{ q }}
MAIL_USERNAME={{ q }}{{ wiring_mail.username | default('', true) }}{{ q }}
MAIL_PASSWORD={{ q }}{{ wiring_mail.password | default('', true) }}{{ q }}
MAIL_ENCRYPTION={{ q }}{{ wiring_mail.encryption | default('', true) }}{{ q }}
