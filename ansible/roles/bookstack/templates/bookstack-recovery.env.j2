# Managed by homelab-infra. Credentials are copied from Vaultwarden at deploy time and
# this root-readable-only file is consumed by the host recovery timer; never edit it.
BOOKSTACK_PROJECT_DIR={{ bookstack_project_dir | quote }}
BOOKSTACK_SERVICE=bookstack
BOOKSTACK_DATA_PATH={{ app_config.app.data_path | quote }}
BOOKSTACK_DB_PROVIDER={{ app_config.app.database.provider | quote }}
BOOKSTACK_DB_HOST={{ app_config.app.database_host | quote }}
BOOKSTACK_DB_PORT={{ app_config.app.database_port | quote }}
BOOKSTACK_DB_NAME={{ app_config.app.database.name | quote }}
BOOKSTACK_DB_USER={{ app_config.app.database_user | quote }}
BOOKSTACK_DB_PASSWORD={{ app_config.app.database_password | quote }}
BOOKSTACK_DB_CLIENT_IMAGE={{ database_app_target.client_image | quote }}
DATABASE_CLIENT_SCRIPT={{ database_client_script | quote }}
PBS_CLIENT_SCRIPT={{ pbs_client_script | quote }}
PBS_CLIENT_CONFIG={{ pbs_client_config | quote }}
PBS_BACKUP_ID={{ (app_config.backup.backup_id | default('', true) or instance) | quote }}
PBS_RETENTION_DAYS={{ (app_config.backup.retention_days | int) | quote }}
