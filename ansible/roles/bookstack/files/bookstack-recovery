#!/bin/bash
# Application-consistent BookStack backup helper, run by the recovery timer and the Backup
# playbook. The role's tasks/restore.yml restores through the shared swap.
#
# This file deliberately contains no credentials. The role writes one root-only env file
# from the canonical Vaultwarden item, and the shared PBS client script
# (tasks/backup/scripts/pbs-client.sh) reads the instance's root-only client settings. The
# database dump and /config archive are uploaded as two archives in ONE PBS snapshot, so a
# restore cannot accidentally pair page media with a different database point in time.
set -Eeuo pipefail

CONFIG=${BOOKSTACK_RECOVERY_CONFIG:-/etc/homelab-infra/bookstack/${BOOKSTACK_INSTANCE:-bookstack}.env}
if [[ ! -r "$CONFIG" ]]; then
  echo "BookStack recovery is not configured: $CONFIG is absent. Deploy with backup enabled and a PBS target." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
. "$CONFIG"
set +a
for required in BOOKSTACK_PROJECT_DIR BOOKSTACK_SERVICE BOOKSTACK_DATA_PATH \
  BOOKSTACK_DB_PROVIDER BOOKSTACK_DB_HOST BOOKSTACK_DB_PORT BOOKSTACK_DB_NAME BOOKSTACK_DB_USER \
  BOOKSTACK_DB_PASSWORD BOOKSTACK_DB_CLIENT_IMAGE DATABASE_CLIENT_SCRIPT \
  PBS_CLIENT_SCRIPT PBS_CLIENT_CONFIG PBS_BACKUP_ID PBS_RETENTION_DAYS; do
  [[ -n "${!required:-}" ]] || { echo "BookStack recovery configuration is incomplete: $required" >&2; exit 1; }
done

[[ "$PBS_BACKUP_ID" =~ ^[A-Za-z0-9_.-]+$ ]] || {
  echo "BookStack recovery backup id is unsafe" >&2
  exit 1
}

compose=(docker compose --project-directory "$BOOKSTACK_PROJECT_DIR" -f "$BOOKSTACK_PROJECT_DIR/docker-compose.yml")
work=$(mktemp -d /var/tmp/homelab-bookstack.XXXXXX)
stopped=0

stop_bookstack() {
  "${compose[@]}" stop "$BOOKSTACK_SERVICE" >/dev/null
  stopped=1
}

start_bookstack() {
  "${compose[@]}" start "$BOOKSTACK_SERVICE" >/dev/null
  stopped=0
}

# Dump the named database with the shared client (tasks/database/scripts/
# database-client.sh) in the server-matched image, as the application's own login.
database_client() {
  local action=$1 file=$2
  DB_ENGINE="$BOOKSTACK_DB_PROVIDER" DB_HOST="$BOOKSTACK_DB_HOST" DB_PORT="$BOOKSTACK_DB_PORT" \
    DB_NAME="$BOOKSTACK_DB_NAME" DB_USER="$BOOKSTACK_DB_USER" DB_PASSWORD="$BOOKSTACK_DB_PASSWORD" \
    docker run --rm --network host \
    -v "$(dirname -- "$file"):/work" \
    -v "$DATABASE_CLIENT_SCRIPT:/usr/local/bin/database-client.sh:ro" \
    -e DB_ENGINE -e DB_HOST -e DB_PORT -e DB_NAME -e DB_USER -e DB_PASSWORD \
    --entrypoint /bin/sh "$BOOKSTACK_DB_CLIENT_IMAGE" \
    /usr/local/bin/database-client.sh "$action" "/work/$(basename -- "$file")"
}

pbs_client() {
  "$PBS_CLIENT_SCRIPT" "$@"
}

finish() {
  local rc=$?
  trap - EXIT
  if [[ "$stopped" == 1 ]]; then
    start_bookstack >/dev/null 2>&1 || true
  fi
  rm -rf -- "$work" || true
  exit "$rc"
}
trap finish EXIT

backup() {
  # BookStack is stopped before the dump and the archive. The external backend remains
  # available to every other application on it; only this application's writes pause.
  stop_bookstack
  mkdir -p "$work/database"
  database_client dump "$work/database/database.sql"
  echo "dumped BookStack database $BOOKSTACK_DB_NAME ($(wc -c < "$work/database/database.sql") bytes)"
  # Keep the source point through a fresh safety backup and one restore retry.
  pbs_client backup --id "$PBS_BACKUP_ID" --keep-last 3 --keep-daily "$PBS_RETENTION_DAYS" \
    database.pxar:"$work/database" storage.pxar:"$BOOKSTACK_DATA_PATH"
  echo "BookStack backup complete"
  start_bookstack
}

case "${1:-}" in
  --backup) backup ;;
  *) echo "usage: $0 --backup" >&2; exit 2 ;;
esac
