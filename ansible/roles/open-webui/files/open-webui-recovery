#!/bin/bash
# Application-consistent Open WebUI capture runner. It uses the product's documented
# stop-and-copy boundary for the complete persistent data directory, checks webui.db, and
# uploads the directory as data.pxar through the shared PBS client script
# (tasks/backup/scripts/pbs-client.sh). Credentials are supplied only by the root-only
# client settings the role installs; this script contains none.
set -Eeuo pipefail
umask 077

INSTANCE=${OPEN_WEBUI_INSTANCE:-open-webui}
CONFIG="/etc/homelab-infra/open-webui/${INSTANCE}.env"
if [[ ! -r "$CONFIG" ]]; then
  echo "Open WebUI recovery is not configured: $CONFIG is absent. Deploy with backup enabled and a PBS target." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
. "$CONFIG"
set +a

for required in OPEN_WEBUI_PROJECT_DIR OPEN_WEBUI_SERVICE OPEN_WEBUI_DATA_PATH \
  OPEN_WEBUI_IMAGE OPEN_WEBUI_BACKUP_ID PBS_CLIENT_SCRIPT PBS_CLIENT_CONFIG; do
  [[ -n "${!required:-}" ]] || { echo "Open WebUI recovery configuration is incomplete: $required" >&2; exit 1; }
done

[[ "$OPEN_WEBUI_BACKUP_ID" =~ ^[A-Za-z0-9_.-]+$ ]] || {
  echo "Open WebUI recovery backup id is unsafe" >&2
  exit 1
}
[[ -d "$OPEN_WEBUI_DATA_PATH" && ! -L "$OPEN_WEBUI_DATA_PATH" && -s "$OPEN_WEBUI_DATA_PATH/webui.db" ]] || {
  echo "Open WebUI persistent data or webui.db is missing; refusing an incomplete recovery point" >&2
  exit 1
}

compose=(docker compose --project-directory "$OPEN_WEBUI_PROJECT_DIR" -f "$OPEN_WEBUI_PROJECT_DIR/docker-compose.yml")
lock="/run/lock/homelab-infra-open-webui-${INSTANCE}.lock"
lock_acquired=0
stopped=0
restart_on_failure=0

finish() {
  local rc=$?
  if [[ "$stopped" == 1 && "$restart_on_failure" == 1 ]]; then
    "${compose[@]}" start "$OPEN_WEBUI_SERVICE" >/dev/null 2>&1 || true
  fi
  if [[ "$lock_acquired" == 1 ]]; then
    rmdir -- "$lock" 2>/dev/null || true
  fi
  exit "$rc"
}
trap finish EXIT

backup() {
  if ! mkdir -m 0700 -- "$lock"; then
    echo "Open WebUI recovery is already running for $INSTANCE; refusing overlapping backup/restore work" >&2
    exit 1
  fi
  lock_acquired=1
  # SQLite is single-instance state. Stop this Compose service before checking or reading
  # the data tree; selected Ollama/LiteLLM services and their model stores stay untouched.
  "${compose[@]}" stop "$OPEN_WEBUI_SERVICE" >/dev/null
  stopped=1
  restart_on_failure=1
  # The pinned Open WebUI image's own Python checks the database it will open.
  docker run --rm --network none --volume "$OPEN_WEBUI_DATA_PATH:/source:ro" \
    --entrypoint python3 "$OPEN_WEBUI_IMAGE" -c '
import sqlite3, sys
result = sqlite3.connect("file:/source/webui.db?mode=ro", uri=True).execute("PRAGMA integrity_check").fetchone()[0]
sys.exit(0 if result == "ok" else "webui.db failed its SQLite integrity check: " + result)'
  # Open WebUI keeps every point; PBS's own retention prunes the group.
  "$PBS_CLIENT_SCRIPT" backup --id "$OPEN_WEBUI_BACKUP_ID" --no-prune data.pxar:"$OPEN_WEBUI_DATA_PATH"
  echo "Open WebUI backup complete (data.pxar; SQLite integrity verified)"
  "${compose[@]}" start "$OPEN_WEBUI_SERVICE" >/dev/null
  stopped=0
  restart_on_failure=0
}

case "${1:-}" in
  --backup) backup ;;
  *) echo "usage: $0 --backup" >&2; exit 2 ;;
esac
