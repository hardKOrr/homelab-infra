{#
  Open WebUI's one owned Deployment, Service, Ingress and persistent data claim. The
  upstream image stores its database, chats and uploads under /app/backend/data and
  listens on container port 8080; app.port remains the service port shared with the
  existing Docker deployment. The claim deliberately omits the class selector so the
  cluster default StorageClass is used.
#}
{% set labels %}
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
{% endset %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-data
  labels:
{{ labels }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
    spec:
      terminationGracePeriodSeconds: 30
      containers:
        - name: open-webui
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: {{ instance }}-env
            - secretRef:
                name: {{ instance }}-upstream
            - secretRef:
                name: {{ instance }}-key
          ports:
            - name: http
              containerPort: {{ app_config.app.container_port }}
          volumeMounts:
            - name: data
              mountPath: {{ app_config.app.data_mount_path }}
          startupProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 30
            failureThreshold: 3
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ instance }}-data
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - name: http
      port: {{ app_config.app.port }}
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  rules:
    - host: {{ open_webui_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
