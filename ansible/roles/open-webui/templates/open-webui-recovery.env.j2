# Managed by homelab-infra. PBS credentials are root-only and are never printed.
OPEN_WEBUI_PROJECT_DIR={{ open_webui_project_dir | quote }}
OPEN_WEBUI_SERVICE={{ app_config.app.service_name | quote }}
OPEN_WEBUI_DATA_PATH={{ app_config.app.data_path | quote }}
OPEN_WEBUI_CLIENT_IMAGE={{ app_config.backup.client.image | quote }}
OPEN_WEBUI_PBS_KEY_URL={{ app_config.backup.client.key_url | quote }}
OPEN_WEBUI_PBS_APT_REPO={{ (app_config.backup.client.repository ~ ' ' ~ app_config.backup.client.suite ~ ' ' ~ app_config.backup.client.component) | quote }}
PBS_REPOSITORY={{ k8s_pbs_repository | quote }}
PBS_FINGERPRINT={{ k8s_pbs_fingerprint | quote }}
PBS_PASSWORD={{ k8s_pbs_password | quote }}
OPEN_WEBUI_BACKUP_ID={{ (app_config.backup.backup_id | default('', true) or instance) | quote }}
