# Managed by homelab-infra. PBS credentials live only in PBS_CLIENT_CONFIG, root-only.
OPEN_WEBUI_PROJECT_DIR={{ open_webui_project_dir | quote }}
OPEN_WEBUI_SERVICE={{ app_config.app.service_name | quote }}
OPEN_WEBUI_DATA_PATH={{ app_config.app.data_path | quote }}
OPEN_WEBUI_IMAGE={{ app_config.app.image | quote }}
OPEN_WEBUI_BACKUP_ID={{ (app_config.backup.backup_id | default('', true) or instance) | quote }}
PBS_CLIENT_SCRIPT={{ pbs_client_script | quote }}
PBS_CLIENT_CONFIG={{ pbs_client_config | quote }}
