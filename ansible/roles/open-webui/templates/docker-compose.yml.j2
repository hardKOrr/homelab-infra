{{ ansible_managed | comment }}
services:
  open-webui:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}-open-webui"
    restart: unless-stopped
    env_file:
      - "{{ open_webui_env_file }}"
    ports:
      - "{{ app_config.app.port }}:8080"
    volumes:
      - "{{ app_config.app.data_path }}:/app/backend/data"
    healthcheck:
      test: ["CMD-SHELL", "curl --silent --fail http://127.0.0.1:8080/health >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 30s
