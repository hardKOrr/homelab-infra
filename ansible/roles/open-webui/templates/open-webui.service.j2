{{ ansible_managed | comment }}
[Unit]
Description=Open WebUI ({{ instance }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ open_webui_native_user }}
Group={{ open_webui_native_user }}
WorkingDirectory={{ open_webui_native_home }}
Environment=HOME={{ open_webui_native_home }}
Environment=DATA_DIR={{ app_config.app.data_path }}
EnvironmentFile={{ open_webui_env_file }}
ExecStart={{ open_webui_native_venv }}/bin/open-webui serve --host 0.0.0.0 --port {{ app_config.app.port }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
