#!/bin/bash
# Application-consistent Plane backup runner. Credentials are read only from the root-only
# environment file rendered by the deployment role and the instance's root-only PBS client
# settings; this script contains no secret values. The shared PBS client script
# (tasks/backup/scripts/pbs-client.sh) uploads the point.
set -Eeuo pipefail
umask 077

INSTANCE=${PLANE_INSTANCE:-plane}
CONFIG="/etc/homelab-infra/plane/${INSTANCE}.env"
if [[ ! -r "$CONFIG" ]]; then
  echo "Plane recovery is not configured: $CONFIG is absent. Deploy with backup enabled and a PBS target." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
. "$CONFIG"
set +a

for required in PLANE_PROJECT_DIR PLANE_DATA_PATH PLANE_OBJECT_STORAGE_PATH \
  PLANE_DB_HOST PLANE_DB_PORT PLANE_DB_NAME PLANE_DB_USER PLANE_DB_PASSWORD \
  PLANE_REDIS_HOST PLANE_REDIS_PORT PLANE_REDIS_PASSWORD PLANE_BACKUP_ID PLANE_RELEASE \
  PLANE_POSTGRES_IMAGE PLANE_REDIS_IMAGE DATABASE_CLIENT_SCRIPT \
  PBS_CLIENT_SCRIPT PBS_CLIENT_CONFIG; do
  [[ -n "${!required:-}" ]] || { echo "Plane recovery configuration is incomplete: $required" >&2; exit 1; }
done

# The client containers use their conventional variable names. Keep the values out of
# Docker's argv by exporting aliases and passing only the variable names with --env.
export DB_HOST="$PLANE_DB_HOST"
export DB_PORT="$PLANE_DB_PORT"
export DB_NAME="$PLANE_DB_NAME"
export DB_USER="$PLANE_DB_USER"
export DB_PASSWORD="$PLANE_DB_PASSWORD"
export REDIS_HOST="$PLANE_REDIS_HOST"
export REDIS_PORT="$PLANE_REDIS_PORT"
export REDISCLI_AUTH="$PLANE_REDIS_PASSWORD"

[[ "$PLANE_BACKUP_ID" =~ ^[A-Za-z0-9_.-]+$ ]] || {
  echo "Plane recovery backup id is unsafe" >&2
  exit 1
}
[[ "$PLANE_DB_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
  echo "Plane recovery database name is unsafe" >&2
  exit 1
}
[[ "$PLANE_RELEASE" =~ ^[A-Za-z0-9._+-]+$ ]] || {
  echo "Plane recovery release label is unsafe" >&2
  exit 1
}
[[ "$PLANE_DATA_PATH" == "$PLANE_PROJECT_DIR/"* &&
   "$PLANE_OBJECT_STORAGE_PATH" == "$PLANE_PROJECT_DIR/"* &&
   -d "$PLANE_DATA_PATH" && ! -L "$PLANE_DATA_PATH" &&
   -d "$PLANE_OBJECT_STORAGE_PATH" && ! -L "$PLANE_OBJECT_STORAGE_PATH" ]] || {
  echo "Plane recovery paths must be real directories beneath the owned project root" >&2
  exit 1
}
case "$PLANE_OBJECT_STORAGE_PATH" in
  "$PLANE_DATA_PATH"/*) echo "Plane recovery paths overlap" >&2; exit 1 ;;
esac
case "$PLANE_DATA_PATH" in
  "$PLANE_OBJECT_STORAGE_PATH"/*) echo "Plane recovery paths overlap" >&2; exit 1 ;;
esac

compose=(docker compose --project-directory "$PLANE_PROJECT_DIR" -f "$PLANE_PROJECT_DIR/docker-compose.yml")
work=$(mktemp -d /var/tmp/homelab-plane.XXXXXX)
lock="/run/lock/homelab-infra-plane-${INSTANCE}.lock"
lock_acquired=0
stopped=0
restart_on_failure=0

finish() {
  local rc=$?
  rm -rf -- "$work"
  if [[ "$stopped" == 1 && "$restart_on_failure" == 1 ]]; then
    "${compose[@]}" start >/dev/null 2>&1 || true
  fi
  if [[ "$lock_acquired" == 1 ]]; then
    rmdir -- "$lock" 2>/dev/null || true
  fi
  exit "$rc"
}
trap finish EXIT

# Dump or check the named database with the shared client (tasks/database/scripts/
# database-client.sh) in the server-matched image, as the application's own login.
database_client() {
  docker run --rm --network host \
    --volume "$(dirname -- "$2"):/work" \
    --volume "$DATABASE_CLIENT_SCRIPT:/usr/local/bin/database-client.sh:ro" \
    --env DB_ENGINE=postgresql --env DB_HOST --env DB_PORT --env DB_NAME --env DB_USER --env DB_PASSWORD \
    --entrypoint /bin/sh "$PLANE_POSTGRES_IMAGE" \
    /usr/local/bin/database-client.sh "$1" "/work/$(basename -- "$2")"
}

backup() {
  if ! mkdir -m 0700 -- "$lock"; then
    echo "Plane recovery is already running for $INSTANCE; refusing overlapping backup/restore work" >&2
    exit 1
  fi
  lock_acquired=1
  mkdir -p "$work/database" "$work/redis"
  # Stop the complete Plane project so its logical stores and host trees describe one point.
  # The named PostgreSQL/Redis guests and unrelated shared-guest services remain untouched.
  stopped=1
  restart_on_failure=1
  "${compose[@]}" stop

  database_client dump "$work/database/plane.dump"
  printf '%s\n' "$PLANE_RELEASE" > "$work/database/plane-release.txt"
  database_client verify "$work/database/plane.dump"

  docker run --rm --network host \
    --volume "$work/redis:/backup" \
    --env REDIS_HOST --env REDIS_PORT --env REDISCLI_AUTH \
    "$PLANE_REDIS_IMAGE" /bin/sh -ceu \
    'redis-cli --no-auth-warning -h "$REDIS_HOST" -p "$REDIS_PORT" \
      --rdb /backup/dump.rdb'
  test -s "$work/redis/dump.rdb"
  docker run --rm --volume "$work/redis:/backup:ro" "$PLANE_REDIS_IMAGE" \
    redis-check-rdb /backup/dump.rdb >/dev/null

  "$PBS_CLIENT_SCRIPT" backup --id "$PLANE_BACKUP_ID" --no-prune \
    database.pxar:"$work/database" redis.pxar:"$work/redis" data.pxar:"$PLANE_DATA_PATH" \
    object-storage.pxar:"$PLANE_OBJECT_STORAGE_PATH"
  echo "Plane backup complete (database, Redis, server/worker data and object storage)"

  # Do not prune snapshots here. This recovery action preserves existing points; any PBS
  # datastore-wide retention policy is independent and must be verified separately.
  "${compose[@]}" start
  stopped=0
  restart_on_failure=0
}

case "${1:-}" in
  --backup) backup ;;
  *) echo "usage: $0 --backup" >&2; exit 2 ;;
esac
