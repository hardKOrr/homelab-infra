{# One-shot schema migration, run through tasks/kubernetes/run-job.yml after local dependencies are ready. #}
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ instance }}-migrator
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
    app.kubernetes.io/component: migrator
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: migrator
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      initContainers:
        - name: prepare-data
          image: busybox:1.36
          command: [/bin/sh, -c]
          args:
            - mkdir -p /data/api /data/worker /data/beat /data/migrator /data/proxy /data/rabbitmq
          volumeMounts:
            - name: data-root
              mountPath: /data
      containers:
        - name: migrator
          image: makeplane/plane-backend:{{ app_config.app.release }}
          imagePullPolicy: IfNotPresent
          command: [./bin/docker-entrypoint-migrator.sh]
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          volumeMounts:
            - name: data-root
              mountPath: /code/plane/media
              subPath: migrator
      volumes:
        - name: data-root
          persistentVolumeClaim:
            claimName: {{ instance }}-data
