# Managed by homelab-infra. Root-only runtime data; values are copied from Vaultwarden/PBS.
PLANE_PROJECT_DIR={{ plane_project_dir | quote }}
PLANE_DATA_PATH={{ app_config.app.data_path | quote }}
PLANE_OBJECT_STORAGE_PATH={{ app_config.app.object_storage_path | quote }}
PLANE_DB_HOST={{ app_config.app.database_host | quote }}
PLANE_DB_PORT={{ app_config.app.database_port | quote }}
PLANE_DB_NAME={{ app_config.app.database.name | quote }}
PLANE_DB_USER={{ app_config.app.database_user | quote }}
PLANE_DB_PASSWORD={{ app_config.app.database_password | quote }}
PLANE_REDIS_HOST={{ _plane_redis_backend.host | quote }}
PLANE_REDIS_PORT={{ _plane_redis_backend.port | quote }}
PLANE_REDIS_PASSWORD={{ _plane_redis_password | quote }}
PLANE_BACKUP_ID={{ (app_config.backup.backup_id | default('', true) or instance) | quote }}
PLANE_RELEASE={{ app_config.app.release | quote }}
PLANE_PBS_IMAGE={{ app_config.backup.client.image | quote }}
PLANE_POSTGRES_IMAGE={{ app_config.backup.postgres_client_image | quote }}
PLANE_REDIS_IMAGE={{ app_config.backup.redis_client_image | quote }}
PBS_REPOSITORY={{ k8s_pbs_repository | quote }}
PBS_FINGERPRINT={{ k8s_pbs_fingerprint | quote }}
PBS_PASSWORD={{ k8s_pbs_password | quote }}
PBS_KEY_URL={{ app_config.backup.client.key_url | quote }}
PBS_APT_REPO={{ (app_config.backup.client.repository ~ ' ' ~ app_config.backup.client.suite ~ ' ' ~ app_config.backup.client.component) | quote }}
