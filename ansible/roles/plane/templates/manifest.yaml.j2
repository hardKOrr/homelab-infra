{#
  Plane's Kubernetes objects are all namespaced with one set of app labels. The web,
  space, admin, API and live Services retain the names Plane's proxy expects; stateful
  paths preserve the directory layout from the Docker recovery archives.
#}
{% set labels %}
app.kubernetes.io/instance: {{ instance }}
app.kubernetes.io/managed-by: homelab-infra
{% endset %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-data
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.data_storage | int }}Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-object-storage
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.object_storage_storage | int }}Gi
---
# This claim is only a recovery staging volume. The registered Redis service remains the
# runtime backend; the shared backup DB step writes its RDB here before PBS archives it.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-redis-recovery
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.redis_recovery_storage | int }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-mq
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: mq
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: mq
    spec:
      automountServiceAccountToken: false
      initContainers:
        - name: prepare-data
          image: busybox:1.36
          command: [/bin/sh, -c]
          args:
            - mkdir -p /data/api /data/worker /data/beat /data/migrator /data/proxy /data/rabbitmq && chown -R 999:999 /data/rabbitmq
          volumeMounts:
            - name: data-root
              mountPath: /data
      containers:
        - name: rabbitmq
          image: rabbitmq:3.13.6-management-alpine
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          ports:
            - name: amqp
              containerPort: 5672
          volumeMounts:
            - name: data-root
              mountPath: /var/lib/rabbitmq
              subPath: rabbitmq
          readinessProbe:
            exec:
              command: [rabbitmq-diagnostics, -q, ping]
            initialDelaySeconds: 10
            periodSeconds: 10
      volumes:
        - name: data-root
          persistentVolumeClaim:
            claimName: {{ instance }}-data
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}-mq
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: mq
  ports:
    - name: amqp
      port: {{ app_config.app.rabbitmq.port }}
      targetPort: amqp
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-minio
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: minio
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: minio
    spec:
      automountServiceAccountToken: false
      # Both PVCs use node-pinned local-path storage. Keep object storage on the same
      # node as the API/data claim so one shared recovery Job can mount both archives.
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: {{ instance }}
                  app.kubernetes.io/component: api
              topologyKey: kubernetes.io/hostname
      containers:
        - name: minio
          image: docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
          imagePullPolicy: IfNotPresent
          args: [server, /export, --console-address, ":9090"]
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          ports:
            - name: s3
              containerPort: 9000
            - name: console
              containerPort: 9090
          volumeMounts:
            - name: object-storage
              mountPath: /export
          readinessProbe:
            httpGet:
              path: /minio/health/ready
              port: s3
            initialDelaySeconds: 10
            periodSeconds: 10
      volumes:
        - name: object-storage
          persistentVolumeClaim:
            claimName: {{ instance }}-object-storage
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}-minio
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: minio
  ports:
    - name: s3
      port: 9000
      targetPort: s3
    - name: console
      port: 9090
      targetPort: console
