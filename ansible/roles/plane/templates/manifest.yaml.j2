apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-api
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: api
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: api
    spec:
      automountServiceAccountToken: false
      initContainers:
        - name: prepare-data
          image: busybox:1.36
          command: [/bin/sh, -c]
          args:
            - mkdir -p /data/api /data/worker /data/beat /data/migrator /data/proxy /data/rabbitmq
          volumeMounts:
            - name: data-root
              mountPath: /data
        - name: ensure-object-storage-bucket
          image: docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
          imagePullPolicy: IfNotPresent
          command: [/bin/sh, -ceu]
          args:
            - |
              i=0
              until mc alias set local "http://{{ instance }}-minio:9000" "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"; do
                i=$((i + 1))
                if [ "$i" -ge 60 ]; then
                  echo "Plane object storage did not become ready"
                  exit 1
                fi
                sleep 2
              done
              mc mb --ignore-existing "local/$AWS_S3_BUCKET_NAME"
          envFrom:
            - secretRef:
                name: {{ instance }}-env
      containers:
        - name: api
          image: makeplane/plane-backend:{{ app_config.app.release }}
          imagePullPolicy: IfNotPresent
          command: [./bin/docker-entrypoint-api.sh]
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          ports:
            - name: http
              containerPort: 8000
          volumeMounts:
            - name: data-root
              mountPath: /code/plane/media
              subPath: api
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
      volumes:
        - name: data-root
          persistentVolumeClaim:
            claimName: {{ instance }}-data
---
