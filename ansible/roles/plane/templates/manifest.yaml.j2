apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  rules:
    - host: {{ plane_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}-proxy
                port:
                  number: 80
