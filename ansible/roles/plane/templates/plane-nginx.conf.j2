{{ ansible_managed | comment }}
# Plane's proxy (upstream apps/proxy/Caddyfile.ce) as nginx: web and admin are static
# builds served here; the rest is routed to the services on this guest.
map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

map $http_x_forwarded_proto $plane_forwarded_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}

server {
  listen {{ app_config.app.port }} default_server;
  server_name _;
  client_max_body_size 5m;
  large_client_header_buffers 4 32k;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $plane_forwarded_proto;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location = /spaces { return 301 /spaces/; }
  location /spaces/ { proxy_pass http://127.0.0.1:3002; }

  location = /god-mode { return 301 /god-mode/; }
  location /god-mode/ {
    root {{ plane_project_dir }}/admin-root;
    try_files $uri $uri/ /god-mode/index.html;
  }

  location /live/ { proxy_pass http://127.0.0.1:3001; }
  location /api/ { proxy_pass http://127.0.0.1:8000; }
  location /auth/ { proxy_pass http://127.0.0.1:8000; }
  location /static/ { proxy_pass http://127.0.0.1:8000; }

  # Uploads go straight to the object store under the bucket path; its signatures cover the
  # published host, so Host is passed through unchanged.
  location /{{ app_config.app.object_storage.bucket }}/ {
    proxy_pass http://127.0.0.1:9000;
    proxy_request_buffering off;
    proxy_buffering off;
  }
  location = /{{ app_config.app.object_storage.bucket }} { proxy_pass http://127.0.0.1:9000; }

  location / {
    root {{ plane_native_src }}/apps/web/build/client;
    index index.html;
    try_files $uri $uri/ /index.html;
  }
}
