{# The official image persists config, logs, uploaded files and uploaded images. #}
{% set labels %}
app.kubernetes.io/instance: {{ instance }}
app.kubernetes.io/managed-by: homelab-infra
{% endset %}
{% set mounts %}
- name: data
  mountPath: /var/www/html/config
  subPath: config
- name: data
  mountPath: /var/www/html/var/logs
  subPath: logs
- name: data
  mountPath: /var/www/html/docroot/media/files
  subPath: media/files
- name: data
  mountPath: /var/www/html/docroot/media/images
  subPath: media/images
{% endset %}
{% set common_env %}
- name: MAUTIC_DB_HOST
  value: {{ app_config.app.database_host | string | to_json }}
- name: MAUTIC_DB_PORT
  value: {{ app_config.app.database_port | string | to_json }}
- name: MAUTIC_DB_DATABASE
  value: {{ app_config.app.database.name | string | to_json }}
- name: MAUTIC_DB_USER
  value: {{ app_config.app.database_user | string | to_json }}
- name: MAUTIC_DB_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ instance }}-app
      key: database-password
- name: MAUTIC_MESSENGER_DSN_EMAIL
  value: doctrine://default
- name: MAUTIC_MESSENGER_DSN_HIT
  value: doctrine://default
- name: MAUTIC_MESSENGER_DSN_FAILED
  value: doctrine://default
{% endset %}
{% set init %}
initContainers:
  - name: prepare-data
    image: {{ app_config.app.image }}
    imagePullPolicy: IfNotPresent
    command: [/bin/sh, -c]
    args:
      - |
        set -eu
        mkdir -p /data/config /data/logs /data/media/files /data/media/images
        chown 33:33 /data/config /data/logs /data/media /data/media/files /data/media/images
        if [ ! -s /data/config/local.php ]; then
          temporary="/data/config/.local.php.seed.$$"
          cp /seed/local.php "$temporary"
          chmod 0640 "$temporary"
          chown 33:33 "$temporary"
          if ! ln "$temporary" /data/config/local.php 2>/dev/null; then
            test -s /data/config/local.php
          fi
          rm -f "$temporary"
        fi
    volumeMounts:
      - name: data
        mountPath: /data
      - name: app-config
        mountPath: /seed
        readOnly: true
{% endset %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-data
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-web
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
    spec:
{{ init | trim | indent(6, true) }}
      containers:
        - name: mautic
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          env:
{{ common_env | trim | indent(12, true) }}
            - name: DOCKER_MAUTIC_ROLE
              value: mautic_web
          ports:
            - name: http
              containerPort: 80
          volumeMounts:
{{ mounts | trim | indent(12, true) }}
          readinessProbe:
            httpGet:
              path: /
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 60
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ instance }}-data
        - name: app-config
          secret:
            secretName: {{ instance }}-app
            items:
              - key: local.php
                path: local.php
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-cron
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: cron
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: cron
    spec:
{{ init | trim | indent(6, true) }}
      containers:
        - name: mautic
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          env:
{{ common_env | trim | indent(12, true) }}
            - name: DOCKER_MAUTIC_ROLE
              value: mautic_cron
          volumeMounts:
{{ mounts | trim | indent(12, true) }}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ instance }}-data
        - name: app-config
          secret:
            secretName: {{ instance }}-app
            items:
              - key: local.php
                path: local.php
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-worker
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: worker
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: worker
    spec:
{{ init | trim | indent(6, true) }}
      containers:
        - name: mautic
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          env:
{{ common_env | trim | indent(12, true) }}
            - name: DOCKER_MAUTIC_ROLE
              value: mautic_worker
          volumeMounts:
{{ mounts | trim | indent(12, true) }}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ instance }}-data
        - name: app-config
          secret:
            secretName: {{ instance }}-app
            items:
              - key: local.php
                path: local.php
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  rules:
    - host: {{ mautic_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: 80
