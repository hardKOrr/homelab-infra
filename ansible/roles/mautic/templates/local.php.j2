    'mailer_transport' => 'smtp',
    'mailer_host' => '{{ wiring_mail.host }}',
    'mailer_port' => '{{ wiring_mail.port }}',
    'mailer_user' => '{{ wiring_mail.username }}',
    'mailer_password' => '{{ wiring_mail.password }}',
    'mailer_encryption' => '{{ 'ssl' if wiring_mail.encryption == 'ssl' else 'tls' }}',
    'mailer_auth_mode' => 'login',
{% endif %}
