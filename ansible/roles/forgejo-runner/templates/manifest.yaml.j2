{# The runner and its Docker-in-Docker sidecar share one pod, so the runner reaches Docker on localhost. #}
{% set labels %}
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
{% endset %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-data
  labels:
{{ labels }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage | default(1) | int }}Gi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ instance }}-entrypoint
  labels:
{{ labels }}
data:
  register-and-run.sh: {{ lookup('ansible.builtin.file', 'register-and-run.sh') | to_json }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: app
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: app
      annotations:
        # Digests only: a changed URL, token, name or label set rolls the pod.
        homelab-infra/registration: "{{ _forgejo_runner_registration_fingerprint }}"
    spec:
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 1000
      containers:
        - name: docker
          image: {{ app_config.app.dind_image }}
          imagePullPolicy: IfNotPresent
          args: ["--mtu=1450"]
          env:
            - name: DOCKER_TLS_CERTDIR
              value: ""
          securityContext:
            privileged: true
          readinessProbe:
            tcpSocket:
              port: 2375
            periodSeconds: 5
            failureThreshold: 24
          volumeMounts:
            - name: docker
              mountPath: /var/lib/docker
        - name: runner
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          command: ["/opt/runner/register-and-run.sh"]
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
          env:
            - name: FORGEJO_INSTANCE_URL
              value: {{ app_config.app.forgejo_url | to_json }}
            - name: FORGEJO_RUNNER_NAME
              value: {{ app_config.app.runner_name | to_json }}
            - name: FORGEJO_RUNNER_LABELS
              value: {{ app_config.app.labels | to_json }}
            - name: DOCKER_HOST
              value: tcp://localhost:2375
            - name: FORGEJO_RUNNER_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ instance }}
                  key: runner-token
          volumeMounts:
            - name: data
              mountPath: /data
            - name: entrypoint
              mountPath: /opt/runner
              readOnly: true
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ instance }}-data
        - name: docker
          emptyDir: {}
        - name: entrypoint
          configMap:
            name: {{ instance }}-entrypoint
            defaultMode: 365
