#!/bin/bash
# Application-consistent WordPress backup helper, run by the recovery timer and the Backup
# playbook. The role's tasks/restore.yml restores through the shared swap.
#
# This file deliberately contains no credentials. The role writes one root-only env file
# from the canonical Vaultwarden item, and the shared PBS client script
# (tasks/backup/scripts/pbs-client.sh) reads the instance's root-only client settings. One
# PBS snapshot contains the named SQL dump and
# wp-content (uploads, themes and operator-installed plugins), so a restore cannot pair
# media with a different database point in time. WordPress core and wp-config.php stay out
# of the point: a restore takes them from the target's pinned image and environment.
set -Eeuo pipefail

CONFIG=${WORDPRESS_RECOVERY_CONFIG:-/etc/homelab-infra/wordpress/${WORDPRESS_INSTANCE:-wordpress}.env}
if [[ ! -r "$CONFIG" ]]; then
  echo "WordPress recovery is not configured: $CONFIG is absent. Deploy with backup enabled and a PBS target." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
. "$CONFIG"
set +a

for required in WORDPRESS_PROJECT_DIR WORDPRESS_SERVICE WORDPRESS_CONTENT_PATH \
  WORDPRESS_DB_HOST WORDPRESS_DB_PORT WORDPRESS_DB_NAME WORDPRESS_DB_USER \
  WORDPRESS_DB_PASSWORD WORDPRESS_DB_PROVIDER WORDPRESS_DB_CLIENT_IMAGE DATABASE_CLIENT_SCRIPT \
  PBS_CLIENT_SCRIPT PBS_CLIENT_CONFIG PBS_BACKUP_ID PBS_RETENTION_DAYS; do
  [[ -n "${!required:-}" ]] || { echo "WordPress recovery configuration is incomplete: $required" >&2; exit 1; }
done

[[ "$PBS_BACKUP_ID" =~ ^[A-Za-z0-9_.-]+$ ]] || {
  echo "WordPress recovery backup id is unsafe" >&2
  exit 1
}

compose=(docker compose --project-directory "$WORDPRESS_PROJECT_DIR" -f "$WORDPRESS_PROJECT_DIR/docker-compose.yml")
work=$(mktemp -d /var/tmp/homelab-wordpress.XXXXXX)
stopped=0

finish() {
  local rc=$?
  trap - EXIT
  if [[ "$stopped" == 1 ]]; then
    "${compose[@]}" start "$WORDPRESS_SERVICE" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$work"
  exit "$rc"
}
trap finish EXIT

# Dump the named database with the shared client (tasks/database/scripts/
# database-client.sh) in the server-matched image, as the application's own login.
database_client() {
  local action=$1 file=$2
  DB_ENGINE="$WORDPRESS_DB_PROVIDER" DB_HOST="$WORDPRESS_DB_HOST" DB_PORT="$WORDPRESS_DB_PORT" \
    DB_NAME="$WORDPRESS_DB_NAME" DB_USER="$WORDPRESS_DB_USER" DB_PASSWORD="$WORDPRESS_DB_PASSWORD" \
    docker run --rm --network host \
    -v "$(dirname -- "$file"):/work" \
    -v "$DATABASE_CLIENT_SCRIPT:/usr/local/bin/database-client.sh:ro" \
    -e DB_ENGINE -e DB_HOST -e DB_PORT -e DB_NAME -e DB_USER -e DB_PASSWORD \
    --entrypoint /bin/sh "$WORDPRESS_DB_CLIENT_IMAGE" \
    /usr/local/bin/database-client.sh "$action" "/work/$(basename -- "$file")"
}

pbs_client() {
  "$PBS_CLIENT_SCRIPT" "$@"
}

backup() {
  [[ -d "$WORDPRESS_CONTENT_PATH" ]] || {
    echo "WordPress content path is absent: $WORDPRESS_CONTENT_PATH" >&2
    exit 1
  }
  # WordPress is stopped before the dump and archive. The external backend remains
  # available to every other application on it; only this application's writes pause.
  "${compose[@]}" stop "$WORDPRESS_SERVICE" >/dev/null
  stopped=1
  mkdir -p "$work/database"
  database_client dump "$work/database/database.sql"
  echo "dumped WordPress database $WORDPRESS_DB_NAME ($(wc -c < "$work/database/database.sql") bytes)"
  # The shared client keeps the preceding point through a same-day pre-restore backup.
  pbs_client backup --id "$PBS_BACKUP_ID" --keep-last 2 --keep-daily "$PBS_RETENTION_DAYS" \
    database.pxar:"$work/database" content.pxar:"$WORDPRESS_CONTENT_PATH"
  echo "WordPress backup complete"
  "${compose[@]}" start "$WORDPRESS_SERVICE" >/dev/null
  stopped=0
}

case "${1:-}" in
  --backup) backup ;;
  *) echo "usage: $0 --backup" >&2; exit 2 ;;
esac
