# Managed by homelab-infra. Credentials are copied from Vaultwarden at deploy time and
# this root-readable-only file is consumed by the host recovery timer; never edit it.
WORDPRESS_PROJECT_DIR={{ wordpress_project_dir | quote }}
WORDPRESS_SERVICE=wordpress
WORDPRESS_DATA_PATH={{ app_config.app.data_path | quote }}
WORDPRESS_CONTENT_PATH={{ wordpress_content_path | quote }}
WORDPRESS_FQDN={{ wordpress_fqdn | quote }}
WORDPRESS_CLI_IMAGE={{ app_config.app.cli_image | quote }}
WORDPRESS_ADMIN_USER={{ app_config.app.admin_user | quote }}
WORDPRESS_ADMIN_EMAIL={{ app_config.app.admin_email | quote }}
WORDPRESS_ADMIN_NAME={{ app_config.app.admin_name | quote }}
WORDPRESS_ADMIN_PASSWORD={{ _wordpress_admin_password | quote }}
WORDPRESS_DB_HOST={{ app_config.app.database_host | quote }}
WORDPRESS_DB_PORT={{ app_config.app.database_port | quote }}
WORDPRESS_DB_NAME={{ app_config.app.database.name | quote }}
WORDPRESS_DB_USER={{ app_config.app.database_user | quote }}
WORDPRESS_DB_PASSWORD={{ app_config.app.database_password | quote }}
WORDPRESS_DB_CLIENT_IMAGE={{ app_config.app.database.client_image | default('docker.io/library/mariadb:11.4') | quote }}
PBS_REPOSITORY={{ wordpress_pbs_repository | quote }}
PBS_FINGERPRINT={{ wordpress_pbs_fingerprint | quote }}
PBS_PASSWORD={{ wordpress_pbs_password | quote }}
PBS_BACKUP_ID={{ (app_config.backup.backup_id | default('', true) or instance) | quote }}
PBS_RETENTION_DAYS={{ (app_config.backup.retention_days | int) | quote }}
