{{ ansible_managed | comment }}
services:
  frigate:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}"
    restart: unless-stopped
    stop_grace_period: 30s
    shm_size: "{{ app_config.app.shm_size }}"
    volumes:
      - "{{ app_config.app.config_path }}:/config"
      - "{{ app_config.app.recordings_path }}:/media/frigate"
      # Only the exact node resolved from the named Proxmox mapping reaches this container.
      - "/etc/localtime:/etc/localtime:ro"
    devices:
      # Shared render-node access; this is never PCI passthrough.
      - "{{ app_config.app.igpu_render_node }}:{{ app_config.app.igpu_render_node }}"
      # Exact Coral node from the LXC USB resource-mapping seam; no USB directory bind.
      - "{{ app_config.app.coral_usb_device_path }}:{{ app_config.app.coral_usb_device_path }}"
    ports:
      - "{{ app_config.app.port }}:8971"
      - "8554:8554"
      - "8555:8555/tcp"
      - "8555:8555/udp"
