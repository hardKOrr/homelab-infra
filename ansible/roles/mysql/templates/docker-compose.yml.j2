# docker-compose.yml for MySQL ({{ instance }})
# Managed by homelab-infra — changes made here will be overwritten on next deploy.
# To make permanent changes, update the role template or your instance config.
services:
  {{ app_config.app.service_name }}:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}"
    restart: unless-stopped
    environment:
      - TZ={{ homelabinfra_config.timezone | default('UTC') }}
      # root@localhost has no password; with MYSQL_ROOT_HOST=localhost the image creates no
      # root@%, so root cannot log in through the published port. The host reaches root
      # over the shared socket, as native Deploy does over the guest's socket.
      - MYSQL_ALLOW_EMPTY_PASSWORD=1
      - MYSQL_ROOT_HOST=localhost
    volumes:
      - "{{ mysql_project_dir }}/data:{{ app_config.app.data_path }}"
      - "{{ mysql_project_dir }}/conf.d:/etc/mysql/conf.d:ro"
      - /run/mysqld:/var/run/mysqld
    ports:
      - "{{ app_config.app.port }}:3306"
