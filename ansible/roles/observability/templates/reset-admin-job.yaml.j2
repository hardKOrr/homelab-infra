apiVersion: batch/v1
kind: Job
metadata:
  name: {{ restore_target }}-reset-admin
  labels:
    app.kubernetes.io/instance: {{ restore_target }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext:
        runAsUser: 472
        runAsGroup: 472
        fsGroup: 472
      # `grafana cli` resets the password but cannot rename the user, so the login is set
      # first, directly in the restored database (user id 1 is the built-in administrator).
      initContainers:
        - name: rename
          image: {{ restore_target_config.app.sqlite_image }}
          command:
            - sqlite3
            - /var/lib/grafana/grafana.db
            - "UPDATE user SET login = '{{ restore_target_config.app.admin_user | default('admin') }}' WHERE id = 1;"
          volumeMounts:
            - name: grafana
              mountPath: /var/lib/grafana
      containers:
        - name: reset
          image: {{ restore_target_config.app.grafana_image }}
          # The target's own Secret holds its canonical password (synced at provisioning).
          envFrom:
            - secretRef:
                name: {{ restore_target }}
          command:
            - sh
            - -c
            - grafana cli --homepath /usr/share/grafana admin reset-admin-password "$GF_SECURITY_ADMIN_PASSWORD"
          volumeMounts:
            - name: grafana
              mountPath: /var/lib/grafana
      volumes:
        - name: grafana
          persistentVolumeClaim:
            claimName: {{ restore_target }}-grafana
