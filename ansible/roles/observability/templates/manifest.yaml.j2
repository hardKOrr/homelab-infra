{# Prometheus and Grafana share one pod: Grafana reaches Prometheus on the pod loopback, so
   Prometheus is never published (it has no authentication). Only the Grafana port is
   exposed by the Service and Ingress. Context from tasks/kubernetes.yml:
   _observability_k8s_config (rendered configuration files, by ConfigMap key). #}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ instance }}-config
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
data:
{% for key, content in _observability_k8s_config.items() %}
  {{ key }}: {{ content | to_json }}
{% endfor %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-prometheus
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ app_config.app.prometheus_storage }}Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-grafana
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ app_config.app.grafana_storage }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
      annotations:
        # A changed scrape list or provisioning file rolls the pod, since a ConfigMap
        # mounted as a directory is not re-read by Prometheus or Grafana on its own.
        homelab-infra/config-sha256: {{ _observability_k8s_config | to_json | hash('sha256') }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsGroup: 472
        fsGroup: 472
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: prometheus
          image: {{ app_config.app.prometheus_image }}
          imagePullPolicy: IfNotPresent
          args:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/prometheus
            - --storage.tsdb.retention.time={{ app_config.app.retention | default('30d') }}
            - --web.listen-address=127.0.0.1:9090
          securityContext:
            runAsUser: 65534
          volumeMounts:
            - name: config
              mountPath: /etc/prometheus/prometheus.yml
              subPath: prometheus.yml
              readOnly: true
            - name: prometheus
              mountPath: /prometheus
          readinessProbe:
            exec:
              command: [wget, -q, -O, /dev/null, "http://127.0.0.1:9090/-/ready"]
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            exec:
              command: [wget, -q, -O, /dev/null, "http://127.0.0.1:9090/-/healthy"]
            periodSeconds: 30
            failureThreshold: 3
          startupProbe:
            exec:
              command: [wget, -q, -O, /dev/null, "http://127.0.0.1:9090/-/ready"]
            periodSeconds: 10
            failureThreshold: 60
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
        - name: grafana
          image: {{ app_config.app.grafana_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 472
          envFrom:
            - secretRef:
                name: {{ instance }}
          env:
            - name: GF_SERVER_ROOT_URL
              value: https://{{ observability_fqdn }}
            - name: GF_USERS_ALLOW_SIGN_UP
              value: "false"
            - name: GF_ANALYTICS_REPORTING_ENABLED
              value: "false"
            - name: TZ
              value: {{ homelabinfra_config.timezone | default('UTC') | to_json }}
          ports:
            - containerPort: 3000
          volumeMounts:
            - name: grafana
              mountPath: /var/lib/grafana
            - name: config
              mountPath: /etc/grafana/provisioning/datasources/prometheus.yml
              subPath: datasource.yml
              readOnly: true
            - name: config
              mountPath: /etc/grafana/provisioning/dashboards/homelab-infra.yml
              subPath: dashboards.yml
              readOnly: true
            - name: config
              mountPath: /etc/grafana/dashboards/homelab-nodes.json
              subPath: homelab-nodes.json
              readOnly: true
          startupProbe:
            httpGet:
              path: /api/health
              port: 3000
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /api/health
              port: 3000
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /api/health
              port: 3000
            periodSeconds: 30
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
      volumes:
        - name: config
          configMap:
            name: {{ instance }}-config
        - name: prometheus
          persistentVolumeClaim:
            claimName: {{ instance }}-prometheus
        - name: grafana
          persistentVolumeClaim:
            claimName: {{ instance }}-grafana
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - port: {{ app_config.app.port }}
      targetPort: 3000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  rules:
    - host: {{ observability_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
