# k3s node configuration — managed by homelab-infra (roles/k3s_cluster).
# Rendered per node from ansible/vars/app-defaults/k3s-cluster.yml.
#
# Everything lives here rather than on the installer's command line because the join
# token is one of these values, and slice 204 requires that credentials never reach a
# command line, job output or tracked config. Mode 0600, root-owned.
{% if k8s_cluster_token | default('') | length > 0 and not _k3s_is_founder %}
server: "https://{{ k8s_first_node_ip }}:6443"
token: "{{ k8s_cluster_token }}"
{% elif _k3s_is_founder %}
cluster-init: true
{% endif %}

# The address other servers and the platform reach this node on. Fixed by declaration:
# etcd peers identify each other by address.
node-ip: "{{ k8s_node_spec.ip_address }}"
node-name: "{{ inventory_hostname }}"

# ServiceLB (klipper-lb) is replaced by MetalLB. It binds its port on every node's own
# address, so it yields one address per node and none of them move when a node fails.
# MetalLB L2 gives a single VIP that a surviving node claims within seconds, which is
# what lets the platform Caddy be pointed at one address permanently.
#
# Traefik is NOT disabled. It is the in-cluster ingress controller, and without one an
# Ingress resource means nothing. It terminates plain HTTP on a private address only —
# public TLS stays at the platform Caddy.
#
# local-storage is disabled because this platform owns the local-path provisioner and its
# StorageClass rather than editing the ones k3s ships. The first implementation kept the
# bundled addon and patched its class down from being the default. That patch cannot hold:
# k3s writes its packaged addons into /var/lib/rancher/k3s/server/manifests on EVERY start
# of the unit, its deploy controller re-applies any file whose modification time changed,
# and line 96 of the packaged local-storage.yaml sets
# `storageclass.kubernetes.io/is-default-class: "true"`. So a restart of the service — not
# merely a k3s upgrade, which is the failure the original comment predicted — silently
# restored a second default class. The audit on 2026-08-20 found both classes marked
# default, with the platform's own winning only because its creationTimestamp happened to
# be the newer one. That is a coin toss deciding which reclaim policy an application's
# data gets, and the next k3s upgrade flips the coin.
#
# `disable` is not merely "do not deploy". k3s's deploy controller treats a disabled
# manifest as something to remove: it deletes the resources the addon created, deletes the
# Addon record, and deletes the manifest file itself, then never writes it again. So an
# already-built cluster converges onto this by re-running the job — the bundled
# Deployment, ServiceAccount, RBAC, ConfigMap and `local-path` StorageClass all go away on
# their own. PersistentVolumes, PersistentVolumeClaims and the data under
# storage.path are NOT part of that addon and are not touched, which is what makes the
# transition safe on a cluster that already holds volumes.
disable:
  - servicelb
  - local-storage

# TLS for the API server, so the kubeconfig works when addressed by node IP or VIP
# rather than only by localhost.
tls-san:
  - "{{ k8s_node_spec.ip_address }}"
{% for node in k8s_cluster_config.cluster.nodes %}
  - "{{ node.ip_address }}"
{% endfor %}

# `default-local-storage-path` used to be declared here and is deliberately gone. The flag
# does exactly one thing in k3s: it substitutes %{DEFAULT_LOCAL_STORAGE_PATH}% into the
# packaged local-storage.yaml as that manifest is staged to disk. Nothing else in k3s ever
# reads it. With `local-storage` on the disable list above, the manifest is never staged,
# so the flag would be a declaration that looks authoritative and controls nothing — the
# worst kind of configuration to leave lying about, because the next reader will change it
# and expect the storage path to move.
#
# storage.path now reaches the provisioner the only way it can once the addon is ours: as
# the nodePathMap entry in the local-path-config ConfigMap that
# templates/local-path-provisioner.yaml.j2 renders. One declaration in
# vars/app-defaults/k3s-cluster.yml still feeds it, so the contract and the path in use
# still cannot drift apart.

# Applied at registration, so a node is tainted before the scheduler ever considers it.
# tasks/taints.yml re-asserts the same set on every run, which is what catches a taint
# removed by hand.
{% if k8s_node_spec.taints | default([]) | length > 0 %}
node-taint:
{% for taint in k8s_node_spec.taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}

# The API, the node addresses and the ingress VIP stay on named private networks. This
# cluster publishes nothing itself; applications are published one at a time through the
# platform Caddy by their own deploy jobs.
write-kubeconfig-mode: "0600"
