{{ ansible_managed | comment }}
{# Double-quoted for Compose's env_file: backslash, quote and `$` are escaped and a newline
   becomes \n, so any value reads back verbatim. #}
{% for key, value in _litellm_env.items() %}
{{ key }}="{{ value | string | regex_replace('([\\"$])', '\\\1') | regex_replace('\n', '\\n') }}"
{% endfor %}
