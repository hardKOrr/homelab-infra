{{ ansible_managed | comment }}
{# Double-quoted for Compose's env_file or systemd's EnvironmentFile: backslash and quote
   are escaped and a newline becomes \n, so any value reads back verbatim. Compose also
   expands `$`, which systemd does not, so only Docker escapes it. #}
{% for key, value in _litellm_env.items() %}
{% set escaped = value | string | replace('\\', '\\\\') | replace('"', '\\"') %}
{{ key }}="{{ (escaped if litellm_native | bool else escaped | replace('$', '\\$')) | replace('\n', '\\n') }}"
{% endfor %}
