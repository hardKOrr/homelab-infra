{# ComfyUI (AI-Dock image) in CPU mode: one claim, mounted as the Docker role's five directories. #}
{% set labels %}
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
{% endset %}
{% set dirs = {'models': '/workspace/storage/models', 'user': '/opt/ComfyUI/user',
               'custom_nodes': '/workspace/storage/custom_nodes',
               'input': '/workspace/storage/input', 'output': '/workspace/storage/output'} %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-storage
  labels:
{{ labels }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage | default(100) | int }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: app
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: app
    spec:
      automountServiceAccountToken: false
      initContainers:
        # AI-Dock starts as root and drops to its runtime user; each directory must exist
        # and belong to that user, as storage-ownership.yml does for Docker.
        - name: storage-ownership
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - >-
              for d in {{ dirs.keys() | join(' ') }}; do
              mkdir -p "/storage/$d" && chown {{ comfyui_run_uid }}:{{ comfyui_run_gid }} "/storage/$d";
              done
          volumeMounts:
            - name: storage
              mountPath: /storage
      containers:
        - name: comfyui
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: COMFYUI_PORT_HOST
              value: "8188"
            - name: AUTO_UPDATE
              value: "false"
            - name: TZ
              value: "{{ homelabinfra_config.timezone | default('UTC') }}"
          ports:
            - name: http
              containerPort: 8188
          volumeMounts:
{% for name, path in dirs.items() %}
            - name: storage
              subPath: {{ name }}
              mountPath: {{ path }}
{% endfor %}
          # AI-Dock answers 302 to its login page for unauthenticated requests; the
          # kubelet counts that, like 200, as healthy and does not follow it.
          startupProbe:
            httpGet:
              path: /system_stats
              port: http
            periodSeconds: 5
            failureThreshold: 120
          readinessProbe:
            httpGet:
              path: /system_stats
              port: http
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /system_stats
              port: http
            periodSeconds: 30
            failureThreshold: 6
          resources:
            requests:
              cpu: "2"
              memory: 4Gi
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: app
  ports:
    - name: http
      port: {{ app_config.app.port }}
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  rules:
    - host: {{ comfyui_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
