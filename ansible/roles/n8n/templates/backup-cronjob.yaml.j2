{#
  One application-consistent n8n recovery point: the named PostgreSQL database dump and
  the instance's /home/node/.n8n PVC, paired in one PBS snapshot.
#}
{% set labels %}
app.kubernetes.io/instance: {{ instance }}
app.kubernetes.io/managed-by: homelab-infra
app.kubernetes.io/component: backup
{% endset %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pbs-backup-trust
  labels:
    app.kubernetes.io/managed-by: homelab-infra
    app.kubernetes.io/component: backup
    homelab-infra.io/pbs-fingerprint: managed
data:
  fingerprint: "{{ k8s_pbs_fingerprint }}"
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ instance }}-backup
  labels:
{{ labels | trim | indent(4, true) }}
    homelab-infra.io/pbs-fingerprint: managed
spec:
  schedule: "{{ app_config.backup.schedule }}"
  timeZone: "{{ _n8n_backup_timezone }}"
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 3600
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    metadata:
      labels:
{{ labels | trim | indent(8, true) }}
    spec:
      backoffLimit: 2
      activeDeadlineSeconds: {{ app_config.backup.timeout_seconds | int }}
      template:
        metadata:
          labels:
{{ labels | trim | indent(12, true) }}
        spec:
          restartPolicy: Never
          containers:
            - name: push
              image: {{ app_config.backup.client.image }}
              imagePullPolicy: IfNotPresent
              command: [/bin/sh, -ceu]
              args:
                - |
                  export DEBIAN_FRONTEND=noninteractive
                  apt-get update -qq
                  install -d -m 0755 /etc/apt/keyrings /backup/database
                  curl -fsSL "${PBS_KEY_URL}" -o /etc/apt/keyrings/proxmox-release.gpg
                  echo "deb [signed-by=/etc/apt/keyrings/proxmox-release.gpg] ${PBS_APT_REPO}" \
                    > /etc/apt/sources.list.d/pbs-client.list
                  curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
                    -o /etc/apt/trusted.gpg.d/apt.postgresql.org.asc
                  . /etc/os-release
                  echo "deb http://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
                    > /etc/apt/sources.list.d/postgresql.list
                  apt-get update -qq
                  apt-get install -y -qq --no-install-recommends proxmox-backup-client \
                    "postgresql-client-${PG_CLIENT_VERSION}" >/dev/null
                  pg_dump --format=custom --no-owner --no-privileges \
                    --file="/backup/database/${PGDATABASE}.dump"
                  test -s "/backup/database/${PGDATABASE}.dump"
                  proxmox-backup-client backup \
                    database.pxar:/backup/database data.pxar:/app-data \
                    --backup-id "${BACKUP_ID}"
                  proxmox-backup-client prune "host/${BACKUP_ID}" \
                    --keep-last 2 --keep-daily "${RETENTION_DAYS}"
                  echo "database and n8n data backup complete: host/${BACKUP_ID}"
              env:
                - name: PBS_REPOSITORY
                  value: "{{ _n8n_backup_repository }}"
                - name: PBS_FINGERPRINT
                  valueFrom:
                    configMapKeyRef:
                      name: pbs-backup-trust
                      key: fingerprint
                - name: PBS_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: {{ instance }}-backup
                      key: pbs-password
                - name: BACKUP_ID
                  value: "{{ _n8n_backup_id }}"
                - name: RETENTION_DAYS
                  value: "{{ app_config.backup.retention_days | int }}"
                - name: PBS_KEY_URL
                  value: "{{ app_config.backup.client.key_url }}"
                - name: PBS_APT_REPO
                  value: "{{ app_config.backup.client.repository }} {{ app_config.backup.client.suite }} {{ app_config.backup.client.component }}"
                - name: PGHOST
                  value: "{{ app_config.app.database_host }}"
                - name: PGPORT
                  value: "{{ app_config.app.database_port | string }}"
                - name: PGDATABASE
                  value: "{{ app_config.app.database.name }}"
                - name: PGUSER
                  value: "{{ app_config.app.database_user }}"
                - name: PG_CLIENT_VERSION
                  value: "{{ _n8n_pg_client_version }}"
                - name: PGPASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: {{ instance }}-backup
                      key: db-password
              volumeMounts:
                - name: backup
                  mountPath: /backup
                - name: app-data
                  mountPath: /app-data
                  readOnly: true
              resources:
                requests:
                  cpu: 100m
                  memory: 128Mi
          volumes:
            - name: backup
              emptyDir:
                sizeLimit: {{ app_config.backup.scratch_size | int }}Gi
            - name: app-data
              persistentVolumeClaim:
                claimName: {{ instance }}-storage
                readOnly: true
