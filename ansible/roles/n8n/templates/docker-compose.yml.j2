{{ ansible_managed | comment }}
services:
  n8n:
    image: {{ app_config.app.image }}
    container_name: "{{ instance }}-n8n"
    restart: unless-stopped
    user: "1000:1000"
    env_file:
      - "{{ n8n_env_file }}"
    ports:
      - "{{ app_config.app.port }}:5678"
    volumes:
      - "{{ app_config.app.data_path }}:/home/node/.n8n"
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:5678/healthz || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 30s
