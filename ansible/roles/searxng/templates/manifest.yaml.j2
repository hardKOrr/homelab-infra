{#
  SearXNG and its disposable limiter Redis — everything the instance owns, in the
  namespace the instance owns. Rendered by roles/searxng/tasks/main.yml and applied
  through tasks/kubernetes/apply-manifest.yml.

  NO PersistentVolumeClaim IN THIS FILE. See vars/app-defaults/searxng.yml for why: the
  only state SearXNG needs preserved is secret_key, already recorded in Vaultwarden and
  synced in as a Secret, not a volume. Redis backs the rate limiter only and starts empty
  every time.

  Every object carries the instance labels, and every object is namespaced. Ownership is
  therefore the namespace boundary rather than a label selector.
#}
{% set labels %}
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
{% endset %}
---
# ── Limiter Redis ─────────────────────────────────────────────────────────────
# No volume: every key in it is a rate-limiter counter, and a cache that survives a
# restart is not worth a PVC that pins the pod to a node.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}-redis
  labels:
{{ labels }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: cache
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: cache
    spec:
      containers:
        - name: redis
          image: {{ app_config.app.limiter.image }}
          # Authenticated even though it is only reachable inside the namespace —
          # "internal" is not a credential, the same rule roles/mixpost's Redis follows.
          command: [redis-server, --requirepass, $(REDIS_PASSWORD)]
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef: { name: {{ instance }}, key: redis-password }
          ports:
            - containerPort: 6379
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}-redis
  labels:
{{ labels }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: cache
  ports:
    - port: 6379
      targetPort: 6379
---
# ── SearXNG ───────────────────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
    spec:
      containers:
        - name: searxng
          image: {{ app_config.app.image }}
          env:
            - name: SEARXNG_BASE_URL
              value: "https://{{ searxng_fqdn }}/"
          ports:
            - containerPort: {{ app_config.app.port }}
          volumeMounts:
            - name: settings
              mountPath: /etc/searxng/settings.yml
              subPath: settings.yml
              readOnly: true
          readinessProbe:
            httpGet:
              path: /healthz
              port: {{ app_config.app.port }}
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 30
      volumes:
        - name: settings
          secret:
            secretName: {{ instance }}-settings
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - port: {{ app_config.app.port }}
      targetPort: {{ app_config.app.port }}
---
# ── Ingress ───────────────────────────────────────────────────────────────────
# Plain HTTP to the in-cluster controller, which answers on the MetalLB VIP. TLS is not
# terminated here: the platform Caddy is the sole public TLS edge and proxies to that VIP.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  rules:
    - host: {{ searxng_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
