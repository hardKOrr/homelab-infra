# Vaultwarden environment — managed by homelab-infra.
# Changes made here will be overwritten on next deploy.
# Instance: {{ instance }}
# Full option reference: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

DATA_FOLDER={{ app_config.app.data_path }}
WEB_VAULT_FOLDER={{ vaultwarden_web_vault_dir }}
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT={{ app_config.app.port }}
SIGNUPS_ALLOWED={{ app_config.app.signups_allowed | default(false) | ternary('true', 'false') }}
{% if homelabinfra_infra.domain is defined %}
DOMAIN=https://{{ instance }}.{{ homelabinfra_infra.domain }}
{% endif %}
{% if _admin_token_hash | length > 0 %}
ADMIN_TOKEN={{ _admin_token_hash }}
{% endif %}
