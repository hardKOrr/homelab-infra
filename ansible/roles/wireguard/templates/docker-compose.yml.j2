# docker-compose.yml for WireGuard ({{ instance }})
# Managed by homelab-infra — changes made here will be overwritten on next deploy.
# The wg-quick config is rendered beside it (config/wg_confs/); the container needs
# NET_ADMIN and the host's wireguard kernel module.
services:
  {{ app_config.app.service_name | default('wireguard') }}:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}"
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
    environment:
      # Match the root-only key files rendered and restored by this role.
      - PUID=0
      - PGID=0
      - LOG_CONFS=false
      - TZ={{ homelabinfra_config.timezone | default('UTC') }}
    volumes:
      - "{{ wireguard_project_dir }}/config:/config"
    ports:
      - "{{ app_config.app.port }}:{{ app_config.app.port }}/udp"
