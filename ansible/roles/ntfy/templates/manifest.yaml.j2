{# One claim holds both Ntfy's SQLite auth database and its message/attachment cache. #}
{% set labels %}
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
{% endset %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ instance }}-config
  labels:
{{ labels }}
data:
  server.yml: |
{{ lookup('ansible.builtin.template', role_path ~ '/templates/server.yml.j2') | indent(4, true) }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-storage
  labels:
{{ labels }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  progressDeadlineSeconds: 600
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: server
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: server
    spec:
      terminationGracePeriodSeconds: 30
      containers:
        - name: ntfy
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          args: [serve]
          env:
            - name: NTFY_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ instance }}
                  key: publish-password
          ports:
            - name: http
              containerPort: {{ app_config.app.port }}
          volumeMounts:
            - name: config
              mountPath: /etc/ntfy/server.yml
              subPath: server.yml
              readOnly: true
            - name: storage
              mountPath: {{ app_config.app.data_path }}
              subPath: data
            - name: storage
              mountPath: {{ app_config.app.cache_path }}
              subPath: cache
          startupProbe:
            httpGet:
              path: /v1/health
              port: http
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /v1/health
              port: http
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /v1/health
              port: http
            periodSeconds: 30
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
      volumes:
        - name: config
          configMap:
            name: {{ instance }}-config
        - name: storage
          persistentVolumeClaim:
            claimName: {{ instance }}-storage
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: server
  ports:
    - port: {{ app_config.app.port }}
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  rules:
    - host: {{ ntfy_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
