# slskd ({{ instance }}) environment — managed by homelab-infra, overwritten on every deploy.
# Values are double-quoted so systemd keeps `;` and spaces; same settings as the Compose file.
{% set _shared = app_config.app.shared_dirs | default([]) %}
{% set _env = {
  'TZ': homelabinfra_config.timezone | default('UTC'),
  'DOTNET_SYSTEM_GLOBALIZATION_INVARIANT': '1',
  'SLSKD_APP_DIR': app_config.app.config_path,
  'SLSKD_HTTP_PORT': app_config.app.port,
  'SLSKD_SLSK_LISTEN_PORT': app_config.app.listen_port,
  'SLSKD_SLSK_USERNAME': _slskd_soulseek_username,
  'SLSKD_SLSK_PASSWORD': _slskd_soulseek_password,
  'SLSKD_API_KEY': _slskd_api_key,
  'SLSKD_USERNAME': app_config.app.web_username | default('admin'),
  'SLSKD_PASSWORD': _slskd_web_password,
  'SLSKD_DOWNLOADS_DIR': _slskd_complete_dir,
  'SLSKD_INCOMPLETE_DIR': _slskd_incomplete_dir,
  'SLSKD_REMOTE_FILE_MANAGEMENT': 'true',
} %}
{% if _shared | length > 0 %}
{% set _ = _env.update({'SLSKD_SHARED_DIR': _shared | join(';')}) %}
{% endif %}
{% set _ = _env.update(app_config.app.extra_env | default({})) %}
{% for key, value in _env.items() %}
{{ key }}={{ value | string | to_json }}
{% endfor %}
