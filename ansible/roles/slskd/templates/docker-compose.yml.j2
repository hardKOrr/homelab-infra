# docker-compose.yml for slskd ({{ instance }})
# Managed by homelab-infra — changes made here are overwritten on the next deploy.
# To make permanent changes, edit config/apps/{{ instance }}.yml.
#
# Unlike the LinuxServer images this stack otherwise uses, slskd does not read
# PUID/PGID: ownership is set with the container's own `user:` field, and its
# whole persistent state (settings, shares database, logs) lives under one
# bind mount at /app — there is no separate config file this role authors,
# because every setting below is a documented environment variable.
#
# SLSKD_REMOTE_CONFIGURATION is deliberately left unset (default false): the
# web UI cannot then change server settings, so there is no drift path for
# this role to detect or repair — the opposite of SABnzbd's sabnzbd.ini, and
# why this role carries no read-back/repair block.
services:
  {{ instance }}:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}"
    restart: unless-stopped
    user: "{{ app_config.app.puid | default(1000) }}:{{ app_config.app.pgid | default(1000) }}"
    labels:
      - "com.centurylinklabs.watchtower.enable=true"
    environment:
      - TZ={{ homelabinfra_config.timezone | default('UTC') }}
      - SLSKD_HTTP_PORT={{ app_config.app.container_port | default(app_config.app.port) }}
      - SLSKD_SLSK_LISTEN_PORT={{ app_config.app.listen_port }}
      # The operator's own Soulseek network login — never generated by this
      # platform. See roles/slskd/tasks/main.yml for where it comes from.
      - SLSKD_SLSK_USERNAME={{ _slskd_soulseek_username }}
      - SLSKD_SLSK_PASSWORD={{ _slskd_soulseek_password }}
      # The primary API key every *arr in the lab authenticates to this
      # client with (ansible/vars/media-wiring.yml, `slskd` kind, auth
      # api_key). Defaults to the Administrator role — see the role header.
      - SLSKD_API_KEY={{ _slskd_api_key }}
      # The web UI's own login — a human-facing credential the *arr wiring
      # never touches. Generated once and remembered in Vaultwarden; see
      # roles/slskd/tasks/main.yml for why the documented default
      # (slskd/slskd) is never left in place.
      - SLSKD_USERNAME={{ app_config.app.web_username | default('admin') }}
      - SLSKD_PASSWORD={{ _slskd_web_password }}
      - SLSKD_DOWNLOADS_DIR=/downloads/complete
      - SLSKD_INCOMPLETE_DIR=/downloads/incomplete
{% set _slskd_shared = app_config.app.shared_dirs | default([]) %}
{% if _slskd_shared | length > 0 %}
      - SLSKD_SHARED_DIR={{ range(_slskd_shared | length) | map('string') | map('regex_replace', '^', '/shared/') | join(';') }}
{% endif %}
{% for key, value in (app_config.app.extra_env | default({})).items() %}
      - {{ key }}={{ value }}
{% endfor %}
    volumes:
      - "{{ app_config.app.config_path }}:/app"
      - "{{ app_config.app.download_path }}/complete:/downloads/complete"
      - "{{ app_config.app.download_path }}/incomplete:/downloads/incomplete"
{% for shared in (app_config.app.shared_dirs | default([])) %}
      - "{{ shared }}:/shared/{{ loop.index0 }}:ro"
{% endfor %}
    ports:
      - "{{ app_config.app.port }}:{{ app_config.app.container_port | default(app_config.app.port) }}"
      - "{{ app_config.app.listen_port }}:{{ app_config.app.listen_port }}"
