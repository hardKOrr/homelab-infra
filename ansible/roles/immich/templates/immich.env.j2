{{ ansible_managed | comment }}
# Runtime credentials are rendered from Vaultwarden-backed app_config and are never
# authored in config/apps/{{ instance }}.yml.
IMMICH_VERSION={{ app_config.app.image | regex_replace('^.*:', '') }}
TZ={{ homelabinfra_config.timezone | default('UTC') }}
DB_HOSTNAME={{ app_config.app.database_host }}
DB_PORT={{ app_config.app.database_port }}
DB_USERNAME={{ app_config.app.database_user }}
DB_PASSWORD={{ app_config.app.database_password }}
DB_DATABASE_NAME={{ app_config.app.database.name }}
DB_VECTOR_EXTENSION=pgvector
REDIS_HOSTNAME={{ _immich_redis_backend.host }}
REDIS_PORT={{ _immich_redis_backend.port }}
REDIS_PASSWORD={{ _immich_redis_password }}
REDIS_DBINDEX=0
