{{ ansible_managed | comment }}
# Immich's PostgreSQL and Redis are deliberately absent here. They are named,
# independently managed platform backends with their own credentials and recovery units.
services:
  immich-server:
    image: "{{ app_config.app.image }}"
    container_name: "{{ instance }}-server"
    # The originals mount is owned by media_storage.owner. Run the server as that
    # same uid/gid so uploads and generated assets remain writable on the shared mount.
    user: "{{ app_config.media_storage.owner.uid | int }}:{{ app_config.media_storage.owner.gid | int }}"
    env_file:
      - "{{ immich_env_file }}"
    volumes:
      - "{{ _immich_media_path }}:/data"
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ app_config.app.port }}:2283"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:2283/api/server/ping').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 60s

  immich-machine-learning:
    image: "{{ app_config.app.machine_learning_image }}"
    container_name: "{{ instance }}-machine-learning"
    env_file:
      - "{{ immich_env_file }}"
    volumes:
      - "{{ app_config.app.model_cache_path }}:/cache"
{% if (_hosting_guest_type | default('vm')) == 'lxc' %}
{% set _ml_nodes = app_config.app.devices | default([]) | select('match', '^/dev/dri/') | list %}
{% elif app_config.app.gpu_device | default('', true) | trim | length > 0 %}
{% set _ml_nodes = [app_config.app.gpu_render_node] %}
{% else %}
{% set _ml_nodes = [] %}
{% endif %}
{% if _ml_nodes | length > 0 %}
    devices:
      # A VM receives the dedicated iGPU through PCI passthrough and an LXC the shared
      # host nodes; only the ML service binds them into its container.
{% for node in _ml_nodes %}
      - "{{ node }}:{{ node }}"
{% endfor %}
{% endif %}
    restart: unless-stopped
