apiVersion: v1
kind: Pod
metadata:
  name: {{ actual_budget_reset_instance }}-password-reset
  labels:
    app.kubernetes.io/instance: {{ actual_budget_reset_instance }}
    app.kubernetes.io/managed-by: homelab-infra
    app.kubernetes.io/component: password-reset
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsUser: 1001
    runAsGroup: 1001
    fsGroup: 1001
    fsGroupChangePolicy: OnRootMismatch
  containers:
    - name: actual-budget
      image: {{ actual_budget_reset_image }}
      imagePullPolicy: Always
      volumeMounts:
        - name: data
          mountPath: /data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: {{ actual_budget_reset_instance }}-data
