{{ ansible_managed | comment }}
# Compose environment for Authentik ({{ instance }}) — managed by homelab-infra.
# Mode 0600, root-owned. Every value here is generated once and reused on re-run;
# see the role header for how continuity works.
PG_HOST={{ app_config.app.database_host | default('postgresql') }}
PG_PORT={{ app_config.app.database_port | default(5432) }}
PG_USER={{ app_config.app.database_user | default(authentik_postgres_user) }}
PG_DB={{ app_config.app.database.name if _authentik_external_database else authentik_postgres_db }}
PG_PASS={{ app_config.app.database_password | default(_authentik_pg_pass) }}
AUTHENTIK_SECRET_KEY={{ _authentik_secret_key }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ _authentik_admin_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ _authentik_api_token }}
