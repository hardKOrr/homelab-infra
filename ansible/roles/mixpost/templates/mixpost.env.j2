{{ ansible_managed | comment }}
{# Double-quoted for Compose's env_file: backslash, quote and `$` are escaped (a bare `$`
   would be interpolated) so any value reads back verbatim. #}
{% set _env = {
  'APP_NAME': app_config.app.name | default('Mixpost'),
  'APP_KEY': _mp_app_key,
  'APP_DEBUG': 'false',
  'APP_URL': 'https://' ~ mixpost_fqdn,
  'APP_DOMAIN': mixpost_fqdn,
  'TRUSTED_PROXIES': '*',
  'DB_HOST': app_config.app.database_host,
  'DB_PORT': app_config.app.database_port | string,
  'DB_DATABASE': app_config.app.database.name,
  'DB_USERNAME': app_config.app.database_user,
  'DB_PASSWORD': app_config.app.database_password,
  'REDIS_HOST': instance ~ '-redis',
  'REDIS_PORT': '6379',
  'REDIS_PASSWORD': _mp_redis_password,
} %}
{% for key, value in _env.items() %}
{{ key }}="{{ value | string | regex_replace('([\\"$])', '\\\1') }}"
{% endfor %}
