{# One namespace contains BookStack's application and /config volume. #}
{% set labels %}
app.kubernetes.io/instance: {{ instance }}
app.kubernetes.io/managed-by: homelab-infra
{% endset %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-config
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage | int }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
    spec:
      automountServiceAccountToken: false
      containers:
        - name: bookstack
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          ports:
            - name: http
              containerPort: {{ app_config.app.container_port }}
          volumeMounts:
            - name: config
              mountPath: /config
          readinessProbe:
            httpGet:
              path: /login
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 60
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: {{ instance }}-config
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - name: http
      port: {{ app_config.app.container_port }}
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  rules:
    - host: {{ bookstack_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.container_port }}
