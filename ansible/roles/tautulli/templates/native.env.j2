# Tautulli ({{ instance }}) — managed by homelab-infra; edit config/apps/{{ instance }}.yml instead.
# The same TAUTULLI_* settings the Compose file sets; the Plex token and API key live here.
TZ="{{ homelabinfra_config.timezone | default('UTC') }}"
TAUTULLI_PMS_URL="{{ _tautulli_plex_url }}"
TAUTULLI_PMS_IP="{{ _tautulli_plex_host }}"
TAUTULLI_PMS_PORT="{{ _tautulli_plex_runtime_port }}"
TAUTULLI_PMS_IDENTIFIER="{{ _tautulli_plex_identifier }}"
TAUTULLI_PMS_TOKEN="{{ _tautulli_plex_token }}"
TAUTULLI_PMS_URL_MANUAL="1"
TAUTULLI_FIRST_RUN_COMPLETE="1"
TAUTULLI_API_KEY="{{ _tautulli_api_key }}"
