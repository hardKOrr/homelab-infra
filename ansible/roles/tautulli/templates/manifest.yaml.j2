{# Tautulli: one config volume, the Plex token and API key from the instance Secret. #}
{% set labels %}
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
{% endset %}
{% set container_port = app_config.app.container_port | default(8181) %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-config
  labels:
{{ labels }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: {{ app_config.app.storage | default(2) | int }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
    spec:
      automountServiceAccountToken: false
      containers:
        - name: tautulli
          image: {{ app_config.app.image }}
          imagePullPolicy: Always
          env:
            - {name: PUID, value: "{{ app_config.app.puid | default(1313) }}"}
            - {name: PGID, value: "{{ app_config.app.pgid | default(1313) }}"}
            - {name: TZ, value: "{{ homelabinfra_config.timezone | default('UTC') }}"}
            - {name: TAUTULLI_PMS_URL, value: "{{ _tautulli_plex_url }}"}
            - {name: TAUTULLI_PMS_IP, value: "{{ _tautulli_plex_host }}"}
            - {name: TAUTULLI_PMS_PORT, value: "{{ _tautulli_plex_runtime_port }}"}
            - {name: TAUTULLI_PMS_IDENTIFIER, value: "{{ _tautulli_plex_identifier }}"}
            - {name: TAUTULLI_PMS_URL_MANUAL, value: "1"}
            - {name: TAUTULLI_FIRST_RUN_COMPLETE, value: "1"}
            - name: TAUTULLI_PMS_TOKEN
              valueFrom:
                secretKeyRef: {name: {{ instance }}, key: plex-token}
            - name: TAUTULLI_API_KEY
              valueFrom:
                secretKeyRef: {name: {{ instance }}, key: api-key}
          ports:
            - containerPort: {{ container_port }}
          volumeMounts:
            - name: config
              mountPath: /config
          startupProbe:
            httpGet: {path: /status, port: {{ container_port }}}
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /status, port: {{ container_port }}}
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet: {path: /status, port: {{ container_port }}}
            periodSeconds: 30
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: {{ instance }}-config
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - port: {{ app_config.app.port }}
      targetPort: {{ container_port }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
{{ labels }}
spec:
  rules:
    - host: {{ tautulli_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
