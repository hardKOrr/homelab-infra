---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ instance }}-data
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ app_config.app.storage }}Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ instance }}
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{ instance }}
      app.kubernetes.io/component: web
  template:
    metadata:
      annotations:
        checksum/environment: {{ _forgejo_k8s_env | to_json(sort_keys=True) | hash('sha256') }}
      labels:
        app.kubernetes.io/instance: {{ instance }}
        app.kubernetes.io/managed-by: homelab-infra
        app.kubernetes.io/component: web
    spec:
      automountServiceAccountToken: false
      initContainers:
        - name: seed-configuration
          image: {{ app_config.app.image }}
          command: [/bin/sh, -ec]
          args:
            - |
              mkdir -p /archive/forgejo/gitea/conf
              if [ ! -e /archive/forgejo/gitea/conf/app.ini ]; then
                umask 027
                printf '[security]\nSECRET_KEY = %s\n' "$(forgejo generate secret SECRET_KEY)" > /archive/forgejo/gitea/conf/app.ini
                chown -R 1000:1000 /archive/forgejo
                chmod 0750 /archive/forgejo
              fi
          volumeMounts:
            - name: data
              mountPath: /archive
      containers:
        - name: forgejo
          image: {{ app_config.app.image }}
          imagePullPolicy: Always
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          ports:
            - containerPort: 3000
          volumeMounts:
            - name: data
              mountPath: /data
              subPath: forgejo
          startupProbe:
            httpGet:
              path: /api/healthz
              port: 3000
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /api/healthz
              port: 3000
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /api/healthz
              port: 3000
            periodSeconds: 30
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ instance }}-data
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - port: {{ app_config.app.port }}
      targetPort: 3000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ instance }}
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  rules:
    - host: {{ forgejo_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ instance }}
                port:
                  number: {{ app_config.app.port }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ instance }}-ssh
  labels:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/managed-by: homelab-infra
spec:
  type: NodePort
  selector:
    app.kubernetes.io/instance: {{ instance }}
    app.kubernetes.io/component: web
  ports:
    - port: 2222
      targetPort: 2222
      nodePort: {{ app_config.app.ssh_node_port }}
