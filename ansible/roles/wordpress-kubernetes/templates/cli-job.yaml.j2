{% set labels %}
app.kubernetes.io/instance: {{ instance }}
app.kubernetes.io/managed-by: homelab-infra
app.kubernetes.io/component: wordpress-cli
{% endset %}
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ instance }}-wordpress-{{ wordpress_k8s_cli_mode }}
  labels:
{{ labels | trim | indent(4, true) }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  template:
    metadata:
      labels:
{{ labels | trim | indent(8, true) }}
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 33
        fsGroupChangePolicy: OnRootMismatch
      initContainers:
        # wordpress:cli contains WP-CLI but not WordPress core. Use the pinned application
        # image's installer entry point to prepare the same core and wp-config in this
        # Job's emptyDir, while mounting the instance's durable wp-content claim.
        - name: prepare-wordpress-core
          image: {{ app_config.app.image }}
          imagePullPolicy: IfNotPresent
          command: [/usr/local/bin/docker-ensure-installed.sh]
          args: [/bin/true]
          workingDir: /var/www/html
          envFrom:
            - secretRef:
                name: {{ instance }}-env
          volumeMounts:
            - name: core
              mountPath: /var/www/html
            - name: content
              mountPath: /var/www/html/wp-content
          securityContext:
            runAsUser: 0
      containers:
        - name: wp-cli
          image: {{ app_config.app.cli_image }}
          imagePullPolicy: IfNotPresent
          command: [/bin/sh, -c]
          args:
            - |
              set -eu
{% if wordpress_k8s_cli_mode == 'detect' %}
              # Exit codes: 0 installed with marker, 41 installed without marker,
              # 42 uninstalled, 43 marker/login mismatch. The shared runner returns
              # the main container status without requiring the kubelet log proxy.
              admin_marker={{ wordpress_k8s_admin_marker | to_json }}
              marker_present=false
              if [ -f "$admin_marker" ]; then
                marker_user="$(sed -n '1p' "$admin_marker")"
                marker_email="$(sed -n '2p' "$admin_marker")"
                if [ "$marker_user" != "$WORDPRESS_ADMIN_USER" ] || [ "$marker_email" != "$WORDPRESS_ADMIN_EMAIL" ]; then
                  echo "The wp-content administrator marker does not match the configured login."
                  exit 43
                fi
                marker_present=true
              fi
              wp --path=/var/www/html --skip-plugins --skip-themes db check >/dev/null
              if wp --path=/var/www/html --skip-plugins --skip-themes core is-installed >/dev/null 2>&1; then
                login="$(wp --path=/var/www/html --skip-plugins --skip-themes user get "$WORDPRESS_ADMIN_USER" --field=user_login)"
                email="$(wp --path=/var/www/html --skip-plugins --skip-themes user get "$WORDPRESS_ADMIN_USER" --field=user_email)"
                if [ "$login" != "$WORDPRESS_ADMIN_USER" ] || [ "$email" != "$WORDPRESS_ADMIN_EMAIL" ]; then
                  echo "The initialized WordPress site does not contain the configured administrator."
                  exit 1
                fi
                echo WORDPRESS_INSTALL_STATE=installed
                if [ "$marker_present" = true ]; then
                  exit 0
                fi
                exit 41
              else
                echo WORDPRESS_INSTALL_STATE=uninstalled
                if [ "$marker_present" = true ]; then
                  echo "The administrator marker exists but the WordPress database is not initialized."
                  exit 43
                fi
                exit 42
              fi
{% elif wordpress_k8s_cli_mode == 'initialize' %}
              if [ "{{ _wordpress_k8s_install_state }}" = uninstalled ]; then
                if ! wp --path=/var/www/html --skip-plugins --skip-themes core is-installed >/dev/null 2>&1; then
                  wp --path=/var/www/html --skip-plugins --skip-themes core install \
                    --url="$WORDPRESS_SITE_URL" --title="$WORDPRESS_SITE_TITLE" \
                    --admin_user="$WORDPRESS_ADMIN_USER" \
                    --admin_password="$WORDPRESS_ADMIN_PASSWORD" \
                    --admin_email="$WORDPRESS_ADMIN_EMAIL" --skip-email
                fi
                wp --path=/var/www/html --skip-plugins --skip-themes user update "$WORDPRESS_ADMIN_USER" \
                  --user_pass="$WORDPRESS_ADMIN_PASSWORD" --user_email="$WORDPRESS_ADMIN_EMAIL" \
                  --display_name="$WORDPRESS_ADMIN_NAME"
                wp --path=/var/www/html --skip-plugins --skip-themes theme activate \
                  "$WORDPRESS_DEFAULT_THEME"
              else
                login="$(wp --path=/var/www/html --skip-plugins --skip-themes user get "$WORDPRESS_ADMIN_USER" --field=user_login)"
                email="$(wp --path=/var/www/html --skip-plugins --skip-themes user get "$WORDPRESS_ADMIN_USER" --field=user_email)"
                if [ "$login" != "$WORDPRESS_ADMIN_USER" ] || [ "$email" != "$WORDPRESS_ADMIN_EMAIL" ]; then
                  echo "The initialized WordPress site does not contain the configured administrator."
                  exit 1
                fi
              fi
              wp --path=/var/www/html --skip-plugins --skip-themes eval '
              $user = wp_authenticate(getenv("WORDPRESS_ADMIN_USER"), getenv("WORDPRESS_ADMIN_PASSWORD"));
              if (is_wp_error($user)) {
                  $codes = preg_replace("/[^a-z0-9_,.-]/i", "", implode(",", $user->get_error_codes()));
                  fwrite(STDERR, "WORDPRESS_ADMIN_AUTHENTICATION=failed; codes=" . $codes . "\n");
                  fwrite(STDERR, "The configured WordPress administrator credential could not authenticate.\n");
                  exit(1);
              }
              echo "WORDPRESS_ADMIN_AUTHENTICATION=ok\n";
              '
{% elif wordpress_k8s_cli_mode == 'restore' %}
              wp --path=/var/www/html --skip-plugins --skip-themes option update home "$WORDPRESS_SITE_URL"
              wp --path=/var/www/html --skip-plugins --skip-themes option update siteurl "$WORDPRESS_SITE_URL"
              if wp --path=/var/www/html --skip-plugins --skip-themes user get "$WORDPRESS_ADMIN_USER" --field=ID >/dev/null 2>&1; then
                wp --path=/var/www/html --skip-plugins --skip-themes user update "$WORDPRESS_ADMIN_USER" \
                  --user_pass="$WORDPRESS_ADMIN_PASSWORD" --user_email="$WORDPRESS_ADMIN_EMAIL" \
                  --display_name="$WORDPRESS_ADMIN_NAME"
              else
                wp --path=/var/www/html --skip-plugins --skip-themes user create \
                  "$WORDPRESS_ADMIN_USER" "$WORDPRESS_ADMIN_EMAIL" --role=administrator \
                  --user_pass="$WORDPRESS_ADMIN_PASSWORD" --display_name="$WORDPRESS_ADMIN_NAME"
              fi
              wp --path=/var/www/html --skip-plugins --skip-themes eval '
              $user = wp_authenticate(getenv("WORDPRESS_ADMIN_USER"), getenv("WORDPRESS_ADMIN_PASSWORD"));
              if (is_wp_error($user)) {
                  $codes = preg_replace("/[^a-z0-9_,.-]/i", "", implode(",", $user->get_error_codes()));
                  fwrite(STDERR, "WORDPRESS_ADMIN_AUTHENTICATION=failed; codes=" . $codes . "\n");
                  fwrite(STDERR, "The restored WordPress administrator credential could not authenticate.\n");
                  exit(1);
              }
              echo "WORDPRESS_ADMIN_AUTHENTICATION=ok\n";
              '
{% else %}
              echo "Unsupported WordPress Kubernetes WP-CLI mode: {{ wordpress_k8s_cli_mode }}"
              exit 2
{% endif %}
{% if wordpress_k8s_cli_mode != 'detect' %}
              umask 077
              printf '%s\n%s\n' "$WORDPRESS_ADMIN_USER" "$WORDPRESS_ADMIN_EMAIL" \
                > /var/www/html/wp-content/.homelab-infra-admin
              chmod 0600 /var/www/html/wp-content/.homelab-infra-admin
              chown 33:33 /var/www/html/wp-content/.homelab-infra-admin
{% endif %}
          workingDir: /var/www/html
          envFrom:
            - secretRef:
                name: {{ instance }}-env
{% if wordpress_k8s_cli_mode != 'detect' %}
            - secretRef:
                name: {{ wordpress_k8s_admin_secret }}
{% endif %}
          env:
            - name: WORDPRESS_ADMIN_USER
              value: {{ app_config.app.admin_user | to_json }}
            - name: WORDPRESS_ADMIN_EMAIL
              value: {{ app_config.app.admin_email | to_json }}
            - name: WORDPRESS_ADMIN_NAME
              value: {{ app_config.app.admin_name | to_json }}
            - name: WORDPRESS_DEFAULT_THEME
              value: {{ app_config.app.default_theme | to_json }}
            - name: WORDPRESS_SITE_TITLE
              value: {{ app_config.app.site_title | to_json }}
            - name: WORDPRESS_SITE_URL
              value: {{ ('https://' ~ wordpress_fqdn) | to_json }}
            - name: HOME
              value: /tmp
          volumeMounts:
            - name: core
              mountPath: /var/www/html
            - name: content
              mountPath: /var/www/html/wp-content
          securityContext:
            runAsUser: 33
            runAsGroup: 33
            runAsNonRoot: true
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
      volumes:
        - name: core
          emptyDir: {}
        - name: content
          persistentVolumeClaim:
            claimName: {{ wordpress_k8s_content_claim }}
