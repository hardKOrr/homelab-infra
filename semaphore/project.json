    {
      "name": "Remove App",
      "description": "Stop an app and unwire it from the reverse proxy, Authentik, Uptime Kuma and DNS. config/apps/<instance>.yml is kept as the restore point; no guest is destroyed.",
      "playbook": "ansible/playbooks/apps/remove.yml",
      "arguments": "[]",
      "allow_override_args_in_task": false,
      "suppress_success_alerts": false,
      "app": "ansible",
      "type": "",
      "survey_vars": [
        {
          "name": "instance",
          "title": "Instance",
          "description": "App instance name, e.g. radarr-4k",
          "required": true,
          "type": ""
        },
        {
          "name": "app",
          "title": "App (only if the instance was renamed)",
          "description": "Leave blank unless the instance name differs from the app name, e.g. instance radarr-4k of app radarr",
          "required": false,
          "type": ""
        },
        {
          "name": "delete_data",
          "title": "Delete data",
          "description": "false keeps volumes and data paths so a re-deploy restores the app; true wipes them",
          "required": false,
          "type": "enum",
          "values": [
            { "name": "false", "value": "false" },
            { "name": "true", "value": "true" }
          ]
        }
      ],
      "vaults": [],
      "repository": "homelab-infra",
      "inventory": "Proxmox (dynamic)",
      "environment": "Homelab",
      "view": "Apps"
