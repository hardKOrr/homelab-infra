#!/usr/bin/env python3
"""lab-browser — run a browser spec against an app instance, headless on the runner.

  tools/lab-browser [--ref <git-ref>] <instance> <url> <spec.js>
  tools/lab-browser mautic https://<subdomain>.<domain> ansible/roles/mautic/browser/smoke.js

The spec is read from this checkout and sent with the run, so editing it needs no push;
the runner side (playbooks/maintenance/browser-check.yml, scripts/browser-check.js) comes
from --ref (default master). The spec gets the instance's Vaultwarden fields as `secrets`;
the form of a spec is in ansible/scripts/browser-check.js. Prints one PASS/FAIL line per
step and the result; on a failure, copies its screenshot here and prints the path.
Exit 0 when every step passes. A run takes about 40s plus the spec.
"""
import base64
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import labaccess  # noqa: E402

args = sys.argv[1:]
if not args or args[0] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0 if args else 2)
ref = "master"
if args[0] == "--ref":
    ref, args = args[1], args[2:]
if len(args) != 3:
    labaccess.die("usage: lab-browser [--ref <git-ref>] <instance> <url> <spec.js>")
instance, url, spec_path = args
with open(spec_path, "rb") as handle:
    spec = handle.read()
run_id = f"{instance}-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
rc, output = labaccess.run_marked_playbook(
    ref, "playbooks/maintenance/browser-check.yml",
    {"instance": instance, "url": url, "run_id": run_id, "spec_b64": base64.b64encode(spec).decode()},
    "BROWSER_CHECK_RESULT", f"lab-browser-{instance}")
report = output.decode("utf-8", "replace").rstrip()
print(report)

shot = re.search(r"^SCREENSHOT (\S+)$", report, re.M)
if shot:
    local = os.path.join(os.environ.get("LAB_JOB_DIR", "/tmp/lab-jobs"), os.path.basename(shot.group(1)).replace("fail", run_id + "-fail"))
    os.makedirs(os.path.dirname(local), exist_ok=True)
    ip, vmid = labaccess.runner(labaccess.lab_values())
    data = subprocess.run(labaccess.SSH + [f"root@{ip}", f"pct exec {vmid} -- base64 -w0 {shot.group(1)}"],
                          stdin=subprocess.DEVNULL, capture_output=True)
    if data.returncode == 0:
        with open(local, "wb") as handle:
            handle.write(base64.b64decode(data.stdout))
        print(f"screenshot copied to {local}")
sys.exit(rc)
