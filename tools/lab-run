#!/usr/bin/env python3
"""lab-run — lab-start and lab-wait in one call.

  tools/lab-run <name> [--timeout SECONDS] [--lines N] -- <command...>

Starts the job as lab-start does, then waits on it as lab-wait does, with lab-wait's
output and exit codes: 124 means still running, so continue with `tools/lab-wait <name>`.
When a job with that name is already running, it waits on that job and starts nothing.
"""
import os
import subprocess
import sys

args = sys.argv[1:]
if "--" not in args or args[0] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0 if args[:1] in (["-h"], ["--help"]) else 2)
split = args.index("--")
head, command = args[:split], args[split + 1:]
if not head or not command:
    print(__doc__.strip())
    sys.exit(2)
name, wait_opts = head[0], head[1:]
tools = os.path.dirname(os.path.abspath(__file__))
job_dir = os.environ.get("LAB_JOB_DIR", "/tmp/lab-jobs")
pid_file, rc_file = (os.path.join(job_dir, name + ext) for ext in (".pid", ".rc"))


def running():
    if not os.path.exists(pid_file) or os.path.exists(rc_file):
        return False
    try:
        os.kill(int(open(pid_file).read()), 0)
        return True
    except (OSError, ValueError):
        return False


if running():
    print(f"lab-run: {name} is already running; waiting on it, not starting another")
else:
    started = subprocess.run([os.path.join(tools, "lab-start"), name, "--", *command])
    if started.returncode:
        sys.exit(started.returncode)
sys.stdout.flush()
os.execv(os.path.join(tools, "lab-wait"), ["lab-wait", name, *wait_opts])
