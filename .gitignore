# Environment / secrets
.env
.env.*

# User config (gitignored — never overwritten by git pull).
# This is load-bearing, not housekeeping: lab-run.sh refreshes the runner's checkout with
# `git reset --hard origin/<branch>` before every job, and the reset is only safe because
# nothing under config/ is tracked. proxmox.yml, infrastructure.yml, apps/*.yml,
# .generated/facts.yml and .backups/ all survive it.
#
# ANCHORED with a leading slash. A bare `config/` matches a directory of that name at ANY
# depth, and it silently excluded ansible/tasks/config/ — run-doctor.yml and
# write-config-file.yml, both shipped code. The working tree had them, so both gates were
# green; the runner clones from GitHub, where they did not exist, and the first Bootstrap
# Platform click died on
#
#   Could not find or access '.../ansible/tasks/config/run-doctor.yml'
#
# Only the repo-root config/ is user config. Anything named config/ deeper in the tree is
# ours and belongs in git.
/config/

# Get Config's restore-point archives — real secrets, written on the runner.
# Anchored for the same reason as config/ above.
/artifacts/

# Ansible
*.retry
inventory/hosts.ini
ansible/vars/user-vars.yml

# Python bytecode
__pycache__/
*.pyc

# Editor/OS noise
*.swp
*.swo
.DS_Store
Thumbs.db
.vscode/settings.json

# todo folders
**/todo/*

# ansible-lint / galaxy local cache
ansible/.ansible/
